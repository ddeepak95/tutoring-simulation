            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   इससे धातु का वाष्पशील यौगिक बनता है।",
            "start": 772,
            "end": 811
          },
          {
            "id": "p15",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
