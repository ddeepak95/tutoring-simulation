            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   वाष्पशील यौगिक टूट जाता है और शुद्ध धातु जमा हो जाती है।",
            "start": 969,
