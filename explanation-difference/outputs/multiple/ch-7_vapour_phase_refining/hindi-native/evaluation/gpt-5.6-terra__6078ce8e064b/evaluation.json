        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**वाष्प प्रावस्था परिष्करण (Vapour Phase Refining)** धातुओं को अत्यधिक शुद्ध करने की एक विधि है। इसका उपयोग उन धातुओं के लिए किया जाता है जो किसी उपयुक्त अभिकर्मक के साथ मिलकर **वाष्पशील (volatile) यौगिक** बना सकती हैं।",
            "start": 0,
            "end": 219
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## मूल सिद्धांत",
            "start": 221,
            "end": 236
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "इस विधि में अशुद्ध धातु को पहले एक ऐसे यौगिक में बदला जाता है जो आसानी से गैस/वाष्प बन जाए। फिर उस वाष्पशील यौगिक को अलग स्थान पर गर्म करके तोड़ा जाता है, जिससे **शुद्ध धातु** प्राप्त हो जाती है।",
            "start": 238,
            "end": 433
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "इसे इस प्रकार समझ सकते हैं:",
            "start": 435,
            "end": 462
          },
          {
            "id": "p5",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
