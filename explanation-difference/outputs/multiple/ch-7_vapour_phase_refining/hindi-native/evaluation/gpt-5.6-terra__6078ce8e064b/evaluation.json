            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{अशुद्ध धातु} \\rightarrow \\text{वाष्पशील यौगिक} \\rightarrow \\text{शुद्ध धातु}",
            "start": 467,
            "end": 549
          },
          {
