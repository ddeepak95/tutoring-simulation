            "start": 813,
            "end": 855
          },
          {
            "id": "p16",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   अशुद्धियाँ सामान्यतः वाष्प नहीं बनतीं, इसलिए पीछे रह जाती हैं।",
            "start": 856,
            "end": 921
          },
          {
            "id": "p17",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
