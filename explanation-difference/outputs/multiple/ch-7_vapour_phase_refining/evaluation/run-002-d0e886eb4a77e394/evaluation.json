            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list"
            ],
            "review_flags": [],
            "text": "     - Ni(CO)₄ → Ni (தூய நிக்கல்) + 4CO  ",
            "start": 1174,
            "end": 1215
          },
          {
            "id": "p17",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "       CO மீண்டும் பயன்படுத்தப்படுகிறது.",
            "start": 1216,
            "end": 1256
          },
