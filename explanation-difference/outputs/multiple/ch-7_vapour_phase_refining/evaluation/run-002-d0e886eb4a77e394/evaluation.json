            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "       இது ஆவியாகும் தன்மை கொண்டது.",
            "start": 1084,
            "end": 1119
          },
          {
