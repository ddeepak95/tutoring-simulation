            "id": "p13",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list"
            ],
            "review_flags": [],
            "text": "     - Ni + 4CO → Ni(CO)₄ (நிக்கல் டெட்ராகார்பனைல்)  ",
            "start": 1030,
            "end": 1083
          },
