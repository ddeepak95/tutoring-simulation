        "attributes": {},
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Outlines the reusable two-step sequence: formation of the volatile compound at lower temperature followed by thermal decomposition at higher temperature.",
        "review_flags": [],
        "contextualization": {
