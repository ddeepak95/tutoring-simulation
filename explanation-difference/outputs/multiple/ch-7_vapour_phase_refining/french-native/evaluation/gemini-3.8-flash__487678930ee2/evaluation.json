    "content_units": [
      {
        "id": "u1",
        "kind": "ANALOGY",
        "label": "Taxi analogy explaining the principle of vapour phase refining",
        "attributes": {},
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Introduces the overall principle of vapour phase refining using an intuitive analogy of a fleet of chemical taxis picking up only metal atoms and leaving sand/impurities behind.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p6",
              "quote": "Le **raffinage en phase vapeur**, c'est comme si tu envoyais une flotte de petits « taxis » chimiques (un gaz) qui ne prennent **que** les atomes de métal à leur bord, en ignorant totalement le sable."
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Bonjour ! C’est une excellente question de chimie et de métallurgie. Ne t'en fais pas, le nom a l’air barbare, mais le principe est en réalité très élégant et logique. ",
            "start": 0,
            "end": 168
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Installe-toi, je t’explique tout simplement.",
            "start": 170,
            "end": 214
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 216,
            "end": 219
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1. La grande idée (L'analogie du taxi)",
            "start": 221,
            "end": 263
          },
          {
            "id": "p5",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine que tu aies un tas de sable mélangé à des pépites de métal, et que ce soit impossible de les trier à la main. ",
            "start": 265,
            "end": 383
          },
          {
            "id": "p6",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le **raffinage en phase vapeur**, c'est comme si tu envoyais une flotte de petits « taxis » chimiques (un gaz) qui ne prennent **que** les atomes de métal à leur bord, en ignorant totalement le sable. ",
            "start": 385,
            "end": 586
          },
          {
            "id": "p7",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1. Le métal monte dans le taxi $\\rightarrow$ il devient un gaz lui aussi et s'envole, laissant le sable derrière.",
            "start": 587,
            "end": 700
          },
          {
            "id": "p8",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. On fait rouler le taxi un peu plus loin dans une autre pièce.",
            "start": 701,
            "end": 765
          },
          {
            "id": "p9",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "3. On force le métal à descendre du taxi $\\rightarrow$ le métal redevient solide, totalement pur, et le taxi repart chercher d'autres atomes.",
            "start": 766,
            "end": 907
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "En résumé : **on purifie un métal solide en le transformant temporairement en gaz, pour le séparer de ses impuretés.**",
            "start": 909,
            "end": 1027
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The taxi analogy accurately reflects the selective volatilization and subsequent decomposition steps of vapour phase refining.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Requirements and two-step mechanism of vapour phase refining",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Details the theoretical mechanism, the two necessary conditions (volatility of intermediate compound and ease of decomposition), and the two sequential steps (volatilization at T1 and thermal decomposition at T2).",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1029,
            "end": 1032
          },
          {
            "id": "p12",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 2. Comment ça marche en pratique ? (Les 2 étapes clés)",
            "start": 1034,
            "end": 1092
          },
          {
            "id": "p13",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Ce procédé repose sur une réaction chimique **réversible** (qui peut aller dans un sens puis dans l'autre) contrôlée par la **température**.",
            "start": 1094,
            "end": 1234
          },
          {
            "id": "p14",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Il y a deux conditions absolues pour que ça marche :",
            "start": 1236,
            "end": 1288
          },
          {
            "id": "p15",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1. Le métal doit réagir avec un réactif pour former un composé **volatil** (qui s'évapore facilement).",
            "start": 1289,
            "end": 1391
          },
          {
            "id": "p16",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. Ce composé gazeux doit pouvoir se décomposer facilement pour redonner le métal pur.",
            "start": 1392,
            "end": 1478
          },
          {
            "id": "p17",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "#### Étape 1 : La volatilisation (On fait monter le métal dans le gaz)",
            "start": 1480,
            "end": 1550
          },
          {
            "id": "p18",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "On prend le métal impur (solide). On fait passer un gaz dessus à une **température $T_1$**.",
            "start": 1551,
            "end": 1642
          },
          {
            "id": "p19",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le métal réagit avec le gaz et forme une nouvelle molécule... gazeuse ! ",
            "start": 1643,
            "end": 1715
          },
          {
            "id": "p20",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Les impuretés, elles, ne réagissent pas et restent au fond sous forme solide. On a réussi la séparation.",
            "start": 1716,
            "end": 1820
          },
          {
            "id": "p21",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "#### Étape 2 : La décomposition (On récupère le métal pur)",
            "start": 1822,
            "end": 1880
          },
          {
            "id": "p22",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "On aspire ce nouveau gaz vers un autre endroit du réacteur et on change la température (généralement, on **chauffe beaucoup plus**, à une température $T_2$).",
            "start": 1881,
            "end": 2038
          },
          {
            "id": "p23",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "À cette nouvelle température, la molécule devient instable : elle se « casse ». Le métal redevient un solide ultra-pur qui se dépose sur les parois, et le gaz initial est libéré (puis réutilisé).",
            "start": 2039,
            "end": 2234
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The two fundamental criteria and the temperature-dependent reversible reaction mechanism are chemically correct and standard.",
          "errors": []
        }
      },
