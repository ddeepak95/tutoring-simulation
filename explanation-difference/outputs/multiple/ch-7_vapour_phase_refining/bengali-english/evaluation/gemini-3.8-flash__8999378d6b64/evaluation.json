            "end": 1672
          },
          {
            "id": "p20",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **ধাপ ১:** অশুদ্ধ নিকেলকে কার্বন মনোক্সাইড ($CO$) গ্যাসের সাথে ৩৩০-৩৫০ K তাপমাত্রায় উত্তপ্ত করলে উদ্বায়ী **নিকেল টেট্রাকার্বনিল** বাষ্প তৈরি হয়।",
            "start": 1673,
            "end": 1820
          },
          {
            "id": "p21",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
