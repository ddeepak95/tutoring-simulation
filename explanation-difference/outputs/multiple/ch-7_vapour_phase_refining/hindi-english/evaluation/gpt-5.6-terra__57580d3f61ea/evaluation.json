            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{अशुद्ध धातु} + \\text{अभिकर्मक} \\rightarrow \\text{वाष्पशील यौगिक}",
            "start": 571,
            "end": 641
          },
