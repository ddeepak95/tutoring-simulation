            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Redox வினையின் மையக் கருத்து: **எலக்ட்ரான்களின் பரிமாற்றம் (transfer)**",
            "start": 463,
            "end": 534
          },
