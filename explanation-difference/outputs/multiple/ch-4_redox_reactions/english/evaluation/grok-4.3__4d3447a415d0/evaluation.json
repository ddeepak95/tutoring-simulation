        "kind": "CONCEPT",
        "label": "The Two Halves of Redox: Oxidation and Reduction",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Explains oxidation as electron loss leading to a more positive charge, reduction as electron gain leading to a more negative charge, and their inherently paired nature.",
