          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Redox reactions (short for **reduction-oxidation**) are chemical reactions where electrons move from one substance to another. They’re everywhere—from why iron rusts to how your phone battery works and even how your body gets energy from food. The key idea is that one substance **loses** electrons while another **gains** them at the same time.",
            "start": 38,
            "end": 383
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of redox reactions based on simultaneous electron transfer is accurate.",
          "errors": []
        }
      },
      {
