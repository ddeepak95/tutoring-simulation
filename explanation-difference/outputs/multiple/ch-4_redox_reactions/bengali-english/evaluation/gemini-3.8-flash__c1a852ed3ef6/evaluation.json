          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### রেডক্স (Redox) কথাটির অর্থ কী?",
            "start": 143,
            "end": 177
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "'Redox' শব্দটি এসেছে দুটি শব্দের মিলনে:",
            "start": 178,
            "end": 217
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1. **Red**uction (বিজারণ)",
            "start": 218,
            "end": 243
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. **Ox**idation (জারণ)",
            "start": 244,
            "end": 267
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "অর্থাৎ, যে বিক্রিয়ায় **জারণ এবং বিজারণ একই সাথে ঘটে**, তাকে **রেডক্স বিক্রিয়া (জারণ-বিজারণ বিক্রিয়া)** বলা হয়।",
            "start": 269,
            "end": 379
          }
        ],
        "accuracy": {
