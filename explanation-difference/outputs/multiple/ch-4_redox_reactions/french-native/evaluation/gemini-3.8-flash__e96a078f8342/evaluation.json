          },
          {
            "id": "p45",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. On a 4 $\\text{O}$ à gauche $\\rightarrow$ on met $4\\text{H}_2\\text{O}$ à droite :",
            "start": 3658,
            "end": 3741
          },
          {
            "id": "p46",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "   $$\\text{MnO}_4^- \\rightarrow \\text{Mn}^{2+} + 4\\text{H}_2\\text{O}$$",
            "start": 3742,
            "end": 3812
          },
          {
            "id": "p47",
            "category": "EXAMPLE",
            "attributes": {},
