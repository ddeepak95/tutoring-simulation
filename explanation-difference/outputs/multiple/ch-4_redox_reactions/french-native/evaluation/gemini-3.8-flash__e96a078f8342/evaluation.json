            "id": "p50",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "   Pour passer de $+7$ à $+2$, on ajoute **$5e^-$** à gauche :",
