            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Le **réducteur** est l’espèce qui **donne** des électrons. Elle s’oxyde (son nombre d’oxydation augmente).",
            "start": 979,
            "end": 1087
          },
          {
            "id": "p15",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- L’**oxydant** est l’espèce qui **accepte** des électrons. Elle se réduit (son nombre d’oxydation diminue).",
            "start": 1088,
            "end": 1196
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definitions of reducing agent and oxidizing agent and their oxidation number changes are scientifically correct.",
          "errors": []
