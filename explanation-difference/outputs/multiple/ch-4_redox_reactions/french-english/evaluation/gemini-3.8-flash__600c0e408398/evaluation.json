            "start": 905,
            "end": 935
          },
          {
            "id": "p11",
            "category": "STUDY_SUPPORT",
            "attributes": {
              "subtype": "mnemonic"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "> *   **O**xidation **I**s **L**oss (L'oxydation est une perte)",
            "start": 936,
            "end": 999
          },
          {
            "id": "p12",
            "category": "STUDY_SUPPORT",
            "attributes": {
              "subtype": "mnemonic"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "> *   **R**eduction **I**s **G**ain (La réduction est un gain)",
            "start": 1000,
            "end": 1062
          },
          {
            "id": "p13",
            "category": "STUDY_SUPPORT",
            "attributes": {
              "subtype": "mnemonic"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> ",
            "start": 1063,
            "end": 1065
          },
          {
            "id": "p14",
            "category": "STUDY_SUPPORT",
            "attributes": {
              "subtype": "mnemonic"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> *Variante en français :* Pense à un régime. Si tu **réduis** ton alimentation, tu **gagnes** en légèreté (Réduction = Gain).",
            "start": 1066,
            "end": 1192
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The mnemonics accurately map oxidation to loss of electrons and reduction to gain of electrons.",
