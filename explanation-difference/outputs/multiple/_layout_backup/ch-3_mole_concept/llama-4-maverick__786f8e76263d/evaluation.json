            ],
            "review_flags": [],
            "text": "**Converting between moles, mass, and number of particles**",
            "start": 1934,
            "end": 1993
          },
          {
            "id": "p19",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "You can use the following formulas to convert between moles, mass, and number of particles:",
            "start": 1995,
            "end": 2086
          },
          {
            "id": "p20",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "equation"
            ],
            "review_flags": [],
            "text": "1. **Moles to mass**: mass (g) = number of moles x molar mass (g/mol)",
            "start": 2088,
            "end": 2157
          },
          {
            "id": "p21",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "equation"
            ],
            "review_flags": [],
            "text": "2. **Mass to moles**: number of moles = mass (g) / molar mass (g/mol)",
            "start": 2158,
            "end": 2227
          },
          {
            "id": "p22",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "equation"
            ],
            "review_flags": [],
            "text": "3. **Moles to number of particles**: number of particles = number of moles x Avogadro's Number",
            "start": 2228,
            "end": 2322
          },
          {
            "id": "p23",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list",
              "equation"
            ],
            "review_flags": [],
            "text": "4. **Number of particles to moles**: number of moles = number of particles / Avogadro's Number",
            "start": 2323,
            "end": 2417
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All four conversion formulas connecting moles, mass, molar mass, and particle counts are correct.",
          "errors": []
        }
