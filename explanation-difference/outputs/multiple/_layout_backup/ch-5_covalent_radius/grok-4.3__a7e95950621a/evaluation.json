        "label": "Formal definition of covalent radius",
        "attributes": {
          "depth": "statement"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Defines covalent radius as half of the internuclear distance between two covalently bonded atoms, prefaced by an introductory greeting and section heading.",
