            "category": "STUDY_SUPPORT",
            "attributes": {
              "subtype": "recap"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "  * **Down** a column = Radius gets **larger**.",
            "start": 3140,
            "end": 3187
          },
          {
            "id": "p34",
            "category": "STUDY_SUPPORT",
            "attributes": {
