      {
        "id": "u6",
        "kind": "CONCEPT",
        "label": "Periodic trend: covalent radius down a group",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s4"
        ],
        "rationale": "Explains the trend that atoms get larger down a group due to the addition of principal energy shells.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p24",
              "quote": "It’s like putting on another bulky winter jacket."
            }
          ]
        },
        "passages": [
          {
            "id": "p20",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1860,
            "end": 1863
          },
          {
            "id": "p21",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### How does it change on the Periodic Table? (Trends to know for tests!)",
            "start": 1865,
            "end": 1938
          },
          {
            "id": "p22",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Your chemistry teacher will definitely ask you how covalent radius changes as you move across the periodic table. Here are the two rules:",
            "start": 1940,
            "end": 2077
          },
          {
            "id": "p23",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "#### 1. Going DOWN a group (column) $\\downarrow$ $\\rightarrow$ Atoms get BIGGER.",
            "start": 2079,
            "end": 2159
          },
          {
            "id": "p24",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **Why?** Every time you move down a row, you are adding a completely new **energy level (shell)** of electrons. It’s like putting on another bulky winter jacket. The outer electrons are further from the center, so the covalent radius increases.",
            "start": 2160,
            "end": 2406
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly states and explains the increase in atomic covalent radius down a periodic table group due to additional electron shells.",
          "errors": []
        }
      },
      {
        "id": "u7",
        "kind": "CONCEPT",
        "label": "Periodic trend: covalent radius across a period",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s4"
        ],
        "rationale": "Explains the trend that atoms get smaller across a period due to increased nuclear charge pulling the same electron shell closer.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p25",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "#### 2. Going ACROSS a period (row) from Left to Right $\\rightarrow$ Atoms get SMALLER.",
            "start": 2408,
            "end": 2495
          },
          {
            "id": "p26",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **Why?** *(This one usually tricks students!)* As you go left to right, you are adding more protons to the nucleus and more electrons to the *same* energy level. ",
            "start": 2496,
            "end": 2660
          },
          {
            "id": "p27",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* More protons mean a stronger positive charge in the center. The nucleus acts like a stronger magnet, pulling that electron cloud closer and tighter toward the middle. This shrinks the atom, so the covalent radius decreases.",
            "start": 2661,
            "end": 2886
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately describes the decrease in covalent radius across a period caused by increased effective nuclear charge acting on the same principal energy level.",
          "errors": []
        }
      },
