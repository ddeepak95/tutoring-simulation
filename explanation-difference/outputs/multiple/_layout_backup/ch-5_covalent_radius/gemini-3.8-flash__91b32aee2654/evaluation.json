    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Indeterminate atomic boundary and measurement challenge",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains why measuring the size of an isolated atom directly is impossible due to the lack of a sharp boundary in the electron cloud, supported by the cloud/cotton ball analogy.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p5",
              "quote": "Imagine trying to measure the exact size of a fluffy cloud or a cotton ball. It’s hard, right? There is no hard outer surface—just a fuzzy edge."
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Hello! Welcome to chemistry class. Today, we’re going to tackle a concept that sounds fancy, but is actually very logical once you picture it: the **covalent radius**.",
            "start": 0,
            "end": 167
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Let’s break it down step-by-step.",
            "start": 169,
            "end": 202
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 204,
            "end": 207
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### The Problem: How do you measure an atom?",
            "start": 209,
            "end": 253
          },
          {
            "id": "p5",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine trying to measure the exact size of a fluffy cloud or a cotton ball. It’s hard, right? There is no hard outer surface—just a fuzzy edge. ",
            "start": 255,
            "end": 400
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Atoms are the same way. An atom has a nucleus in the center, surrounded by a \"cloud\" of electrons. Because this cloud doesn't have a sharp boundary, **you can't just take a ruler and measure the radius from the center to the edge.**",
            "start": 402,
            "end": 634
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately describes how the diffuse nature of the electron cloud prevents direct physical measurement of an individual atom's radius.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Measuring internuclear distance via covalent bonding",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Explains how forming a covalent bond locks identical atoms into a fixed, measurable distance that can be measured via X-ray technology.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p7",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### The Solution: Teamwork between atoms!",
            "start": 636,
            "end": 677
          },
          {
            "id": "p8",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "To solve this, scientists wait until two identical atoms bond together by sharing electrons—which is called a **covalent bond**. ",
            "start": 679,
            "end": 808
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "When two identical atoms form a covalent bond, their electron clouds overlap, and their nuclei are locked at a stable, measurable distance from each other. ",
            "start": 810,
            "end": 966
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Scientists can easily measure the distance between the centers (the nuclei) of these two bonded atoms using X-ray technology. ",
            "start": 968,
            "end": 1094
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately explains that covalent bonding creates a fixed internuclear distance that can be experimentally measured using X-ray techniques.",
          "errors": []
        }
      },
      {
        "id": "u3",
        "kind": "CONCEPT",
        "label": "Definition and formula of covalent radius",
        "attributes": {
          "depth": "statement"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "States the formal definition and equation for calculating the covalent radius as half the internuclear distance between bonded identical atoms.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### The Definition",
            "start": 1096,
            "end": 1114
          },
          {
            "id": "p12",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **The covalent radius is simply half the distance between the nuclei of two identical atoms joined by a single covalent bond.**",
            "start": 1116,
            "end": 1245
          },
          {
            "id": "p13",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Here is the simple formula:",
            "start": 1247,
            "end": 1274
          },
          {
            "id": "p14",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{Covalent Radius} = \\frac{\\text{Distance between two nuclei}}{2}$$",
            "start": 1276,
            "end": 1349
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition and formula accurately represent covalent radius for homonuclear single bonds.",
          "errors": []
        }
      },
      {
        "id": "u4",
        "kind": "EXAMPLE",
        "label": "Calculation of chlorine's covalent radius",
        "attributes": {
          "context": "real_world",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Presents a worked calculation of the covalent radius of chlorine using the bond length in Cl2.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p15",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **Example:** In a chlorine molecule ($\\text{Cl}_2$), the distance between the two chlorine nuclei is about **198 picometers** (pm). ",
            "start": 1351,
            "end": 1485
          },
          {
            "id": "p16",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* To find the covalent radius of a single chlorine atom, just divide that by 2:",
            "start": 1486,
            "end": 1565
          },
          {
            "id": "p17",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list"
            ],
            "review_flags": [],
            "text": "  $$\\frac{198}{2} = 99\\text{ pm}$$",
            "start": 1566,
            "end": 1600
          },
          {
            "id": "p18",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* So, the covalent radius of chlorine is **99 pm**.",
            "start": 1601,
            "end": 1652
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The internuclear distance of 198 pm in Cl2 and the resulting covalent radius of 99 pm are factually correct, and the arithmetic is accurate.",
          "errors": []
        }
      },
