          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "For titanium:",
            "start": 1502,
            "end": 1515
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 1517,
            "end": 1519
          },
          {
            "id": "p31",
