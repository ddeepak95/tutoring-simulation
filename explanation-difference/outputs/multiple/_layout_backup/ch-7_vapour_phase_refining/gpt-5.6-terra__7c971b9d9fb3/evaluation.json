    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Definition, principle, and steps of vapour phase refining",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains what vapour phase refining is, the underlying scientific principle, and the sequence of steps that achieve purification.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Vapour phase refining** is a method used to purify metals by converting the impure metal into a **volatile compound** (a compound that easily changes into vapour). This vapour is then decomposed to obtain the **pure metal**.",
            "start": 0,
            "end": 226
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Principle",
            "start": 228,
            "end": 241
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Some metals form gaseous compounds with certain chemicals at low temperatures. When these gaseous compounds are heated at a higher temperature, they break down and deposit the pure metal.",
            "start": 242,
            "end": 429
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Steps involved",
            "start": 431,
            "end": 449
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1. **Formation of a volatile compound**  ",
            "start": 450,
            "end": 491
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   The impure metal reacts with a suitable gas or chemical to form a volatile compound.",
            "start": 492,
            "end": 579
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. **Separation from impurities**  ",
            "start": 581,
            "end": 616
          },
          {
            "id": "p8",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   The volatile compound turns into vapour and separates from the non-volatile impurities, which are left behind.",
            "start": 617,
            "end": 730
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "3. **Decomposition of vapour**  ",
            "start": 732,
            "end": 764
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   The vapour is heated or passed over a hot surface. It decomposes and deposits pure metal.",
            "start": 765,
            "end": 857
          },
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 859,
            "end": 862
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition, temperature-dependent principle, and three steps accurately describe vapour phase refining.",
          "errors": []
        }
      },
      {
