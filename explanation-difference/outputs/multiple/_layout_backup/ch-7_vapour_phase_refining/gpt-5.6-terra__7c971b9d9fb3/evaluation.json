              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Example 1: Mond Process for Nickel",
            "start": 864,
            "end": 901
          },
          {
            "id": "p13",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Nickel is purified using **carbon monoxide**.",
            "start": 903,
            "end": 948
          },
          {
            "id": "p14",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Step 1: Formation of nickel carbonyl",
            "start": 950,
            "end": 990
          },
          {
            "id": "p15",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Impure nickel reacts with carbon monoxide at about **330–350 K**:",
            "start": 991,
            "end": 1056
          },
          {
            "id": "p16",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 1058,
            "end": 1060
          },
          {
            "id": "p17",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{Ni} + 4\\text{CO} \\rightarrow \\text{Ni(CO)}_4",
            "start": 1061,
            "end": 1111
          },
          {
            "id": "p18",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 1112,
            "end": 1114
          },
          {
            "id": "p19",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Nickel tetracarbonyl, \\(\\text{Ni(CO)}_4\\), is a volatile gas.",
            "start": 1116,
            "end": 1177
          },
          {
            "id": "p20",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Step 2: Decomposition",
            "start": 1179,
            "end": 1204
          },
          {
            "id": "p21",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The gas is heated to about **450–470 K**:",
            "start": 1205,
            "end": 1246
          },
          {
            "id": "p22",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 1248,
            "end": 1250
          },
          {
            "id": "p23",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{Ni(CO)}_4 \\rightarrow \\text{Ni} + 4\\text{CO}",
            "start": 1251,
            "end": 1301
          },
          {
            "id": "p24",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 1302,
            "end": 1304
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Pure nickel is deposited, while carbon monoxide can be reused.",
            "start": 1306,
            "end": 1368
          },
          {
            "id": "p26",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1370,
            "end": 1373
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The reaction equations, temperature ranges (330–350 K and 450–470 K), and chemical behavior of nickel tetracarbonyl are accurate.",
          "errors": []
        }
