              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 2. **Van Arkel Method (for Zirconium or Titanium)**",
            "start": 1391,
            "end": 1446
          },
          {
            "id": "p21",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Used for removing **oxygen and nitrogen impurities** from metals like zirconium and titanium.",
            "start": 1448,
            "end": 1541
          },
          {
            "id": "p22",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Step 1:** Impure metal is heated with **iodine** to form a volatile compound.",
            "start": 1543,
            "end": 1622
          },
          {
            "id": "p23",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$Zr + 2I_2 \\rightarrow ZrI_4$$",
            "start": 1624,
            "end": 1655
          },
          {
            "id": "p24",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Step 2:** The zirconium iodide vapor is then decomposed on a **very hot tungsten filament** (about 1800 K), giving pure zirconium.",
            "start": 1657,
            "end": 1789
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$ZrI_4 \\xrightarrow{1800K} Zr \\text{ (pure)} + 2I_2$$",
            "start": 1791,
            "end": 1845
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The iodine gas released can be reused to purify more metal.",
            "start": 1847,
            "end": 1906
          },
          {
            "id": "p27",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1908,
            "end": 1911
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The reaction details, tungsten filament decomposition at ~1800 K, and specific removal of oxygen and nitrogen impurities match textbook metallurgical facts.",
          "errors": []
        }
