    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Atomic structure review: Protons and neutrons",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Reviews subatomic particles in the nucleus (protons determining atomic identity and neutrons contributing mass) as prerequisite knowledge for understanding isotopes.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p5",
              "quote": "Think of protons like an element's **Social Security Number** or **Fingerprint**"
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Hey there! Welcome to class. Don't worry if chemistry sometimes feels like a completely different language—today, we’re going to break down **isotopes**, and I promise it’s much simpler than it sounds. ",
            "start": 0,
            "end": 202
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "To understand an isotope, let’s do a 10-second review of what makes up an atom. ",
            "start": 204,
            "end": 284
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1. The Quick Atomic Review",
            "start": 286,
            "end": 316
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Deep inside every atom is a nucleus, which holds two main particles:",
            "start": 317,
            "end": 385
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "*   **Protons:** These give the atom its identity. (Think of protons like an element's **Social Security Number** or **Fingerprint**). If an atom has 6 protons, it is *always* Carbon. If you change the number of protons, it turns into a completely different element.",
            "start": 386,
            "end": 652
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "*   **Neutrons:** These are neutral particles that sit in the nucleus with the protons. They don’t change the identity of the atom, but they add weight.",
            "start": 653,
            "end": 805
          },
          {
            "id": "p7",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 807,
            "end": 810
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly describes the composition of the nucleus, with protons defining element identity and neutrons providing mass without altering identity.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Definition and properties of isotopes",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Defines isotopes as atoms of the same element with identical proton counts but differing neutron counts, explaining why they exhibit nearly identical chemical behavior but different masses.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p8",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 2. So, What is an Isotope?",
            "start": 812,
            "end": 842
          },
          {
            "id": "p9",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Here is the official definition: ",
            "start": 843,
            "end": 876
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Isotopes are atoms of the same element that have the *same number of protons*, but a *different number of neutrons*.**",
            "start": 877,
            "end": 997
          },
          {
            "id": "p11",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Because they have the same number of protons, they are the **exact same element** and behave almost identically in chemical reactions. But because they have different numbers of neutrons, they have **different weights (masses)**.",
            "start": 999,
            "end": 1228
          },
          {
            "id": "p12",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1230,
            "end": 1233
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition and reasoning regarding chemical identity and mass variation are factually correct.",
          "errors": []
        }
      },
      {
        "id": "u3",
        "kind": "ANALOGY",
        "label": "Backpack analogy for isotopes",
        "attributes": {},
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Uses the comparison of identical twins carrying different weights in backpacks to help the student conceptualize identical elemental identity alongside differing masses.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p16",
              "quote": "However, your twin puts on a heavy backpack full of textbooks, while you wear an empty one."
            }
          ]
        },
        "passages": [
          {
            "id": "p13",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 3. The \"Backpack\" Analogy",
            "start": 1235,
            "end": 1264
          },
          {
            "id": "p14",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine you and your identical twin. ",
            "start": 1265,
            "end": 1302
          },
          {
            "id": "p15",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* You look the same, talk the same, and have the same DNA. ",
            "start": 1303,
            "end": 1362
          },
          {
            "id": "p16",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* However, your twin puts on a heavy backpack full of textbooks, while you wear an empty one. ",
            "start": 1363,
            "end": 1457
          },
          {
            "id": "p17",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Are you still identical twins? **Yes.**",
            "start": 1459,
            "end": 1498
          },
          {
            "id": "p18",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Do you act the same? **Pretty much.**",
            "start": 1499,
            "end": 1536
          },
          {
            "id": "p19",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Does one of you weigh more on a scale? **Definitely.**",
            "start": 1537,
            "end": 1591
          },
          {
            "id": "p20",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "In this analogy:",
            "start": 1593,
            "end": 1609
          },
          {
            "id": "p21",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **You and your twin** = Protons (your identity).",
            "start": 1610,
            "end": 1660
          },
          {
            "id": "p22",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **The books in the backpack** = Neutrons (extra weight, but doesn't change who you are).",
            "start": 1661,
            "end": 1751
          },
          {
            "id": "p23",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1753,
            "end": 1756
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The analogy maps target concepts (protons = identity, neutrons = weight) cleanly and accurately for introductory high school level.",
          "errors": []
        }
      },
      {
        "id": "u4",
        "kind": "EXAMPLE",
        "label": "Carbon isotopes (Carbon-12, Carbon-13, and Carbon-14)",
        "attributes": {
          "context": "real_world",
          "treatment": "illustrative"
        },
        "subtopic_ids": [
          "s4"
        ],
        "rationale": "Illustrates isotopes using carbon isotopes (C-12, C-13, C-14), showing how proton number remains 6 while neutron counts and mass numbers change.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p24",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 4. A Real-World Example: Carbon",
            "start": 1758,
            "end": 1793
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Let’s look at **Carbon**, the building block of life. In nature, Carbon comes in a few \"flavors\" (isotopes):",
            "start": 1794,
            "end": 1902
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1.  **Carbon-12:** Has 6 protons and 6 neutrons. (Total mass = 12). ",
            "start": 1904,
            "end": 1972
          },
          {
            "id": "p27",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "    * *This is standard carbon. About 99% of all carbon on Earth is this type.*",
            "start": 1973,
            "end": 2052
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2.  **Carbon-13:** Has 6 protons and 7 neutrons. (Total mass = 13). ",
            "start": 2053,
            "end": 2121
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "    * *A little heavier, but still carbon!*",
            "start": 2122,
            "end": 2165
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "3.  **Carbon-14:** Has 6 protons and 8 neutrons. (Total mass = 14). ",
            "start": 2166,
            "end": 2234
          },
          {
            "id": "p31",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "    * *Even heavier. In fact, it has too many neutrons, making it unstable (radioactive).*",
            "start": 2235,
            "end": 2325
          },
          {
            "id": "p32",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Notice that the number of **protons (6) never changes**. If it had 7 protons, it would be Nitrogen!",
            "start": 2327,
            "end": 2426
          },
          {
            "id": "p33",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 2428,
            "end": 2431
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All proton, neutron, and mass numbers for carbon isotopes, as well as their natural abundance and stability properties, are accurately stated.",
          "errors": []
        }
      },
