            "review_flags": [],
            "text": "- **Protons** (positive charge) — located in the nucleus",
            "start": 302,
            "end": 358
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **Neutrons** (no charge) — located in the nucleus",
            "start": 359,
            "end": 410
