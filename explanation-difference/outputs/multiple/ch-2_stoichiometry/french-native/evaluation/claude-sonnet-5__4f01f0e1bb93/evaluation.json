            "review_flags": [],
            "text": "$$n(H_2O) = 2 \\text{ mol}$$",
            "start": 1855,
            "end": 1882
          },
          {
            "id": "p34",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**3)** Masse molaire de H₂O = 18 g/mol",
            "start": 1884,
            "end": 1922
          },
