            ],
            "review_flags": [],
            "text": "### 1. Qu’est-ce que la stœchiométrie ?",
            "start": 202,
            "end": 241
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "La stœchiométrie, c’est le calcul des **quantités** de substances qui réagissent et qui se forment dans une réaction chimique.  ",
            "start": 243,
            "end": 371
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition accurately captures the essence of stoichiometry in chemistry.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "ANALOGY",
        "label": "Cooking recipe analogy for stoichiometry",
        "attributes": {},
