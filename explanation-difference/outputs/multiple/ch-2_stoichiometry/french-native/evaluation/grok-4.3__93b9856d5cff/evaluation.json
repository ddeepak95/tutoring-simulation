            "id": "p24",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Reprenons l’équation :  ",
            "start": 1725,
            "end": 1749
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "**2 H₂ + O₂ → 2 H₂O**",
            "start": 1750,
            "end": 1771
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Question** : Si je fais réagir 4 g de H₂, quelle masse d’eau vais-je obtenir (en supposant qu’il y a assez d’oxygène) ?",
            "start": 1773,
            "end": 1894
          },
          {
            "id": "p27",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Méthode** :",
            "start": 1896,
            "end": 1909
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "1. **Convertir les masses en moles**  ",
            "start": 1911,
            "end": 1949
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list"
            ],
            "review_flags": [],
            "text": "   n(H₂) = masse / masse molaire = 4 g ÷ 2 g/mol = **2 moles** de H₂",
            "start": 1950,
            "end": 2018
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "2. **Utiliser les rapports stœchiométriques** (les coefficients)  ",
            "start": 2020,
            "end": 2086
          },
          {
            "id": "p31",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "   D’après l’équation :  ",
            "start": 2087,
            "end": 2112
          },
          {
            "id": "p32",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "   2 moles de H₂ → 2 moles de H₂O  ",
            "start": 2113,
            "end": 2148
          },
          {
            "id": "p33",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "   Donc 1 mole de H₂ → 1 mole de H₂O  ",
            "start": 2149,
            "end": 2187
          },
          {
            "id": "p34",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "   Avec 2 moles de H₂ → **2 moles** de H₂O",
            "start": 2188,
            "end": 2230
          },
          {
            "id": "p35",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "3. **Reconvertir les moles en masse**  ",
            "start": 2232,
            "end": 2271
          },
          {
            "id": "p36",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list"
            ],
            "review_flags": [],
            "text": "   Masse d’eau = nombre de moles × masse molaire = 2 mol × 18 g/mol = **36 g**",
            "start": 2272,
            "end": 2350
          },
          {
            "id": "p37",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Réponse** : On obtient 36 g d’eau.",
            "start": 2352,
            "end": 2388
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All calculations (moles of H2 = 2 mol, stoichiometric ratio 1:1, moles of H2O = 2 mol, mass of H2O = 36 g) are correct.",
          "errors": []
        }
