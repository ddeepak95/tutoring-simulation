            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- La **masse molaire** (notée *M*) est la masse d’1 mole d’une substance, exprimée en g/mol.",
            "start": 1490,
            "end": 1582
          }
        ],
        "accuracy": {
