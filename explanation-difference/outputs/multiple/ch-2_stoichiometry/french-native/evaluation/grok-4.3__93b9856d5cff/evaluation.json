          "s1"
        ],
        "rationale": "Uses a pancake recipe analogy to explain how stoichiometric proportions work between reactants and products.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p4",
              "quote": "Imagine une recette de cuisine : pour faire 4 crêpes, tu as besoin de 2 œufs, 200 g de farine et ½ litre de lait. Si tu veux en faire 8, tu doubles tout. En chimie, c’est exactement la même idée : les « ingrédients » (les réactifs) doivent être dans des proportions précises pour obtenir les « plats » (les produits)."
            }
          ]
        },
