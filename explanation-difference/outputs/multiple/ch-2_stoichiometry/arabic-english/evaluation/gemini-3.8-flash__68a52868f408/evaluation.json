            "start": 353,
            "end": 356
          },
          {
            "id": "p6",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1. تشبيه المطبخ (سر الفكرة) 🍳",
            "start": 358,
            "end": 391
          },
          {
            "id": "p7",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "تخيل أنك تريد عمل ساندويتش جبن، ووصفة الساندويتش الواحد هي:",
            "start": 392,
            "end": 451
          },
          {
            "id": "p8",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **2 شريحة خبز + 1 شريحة جبن = 1 ساندويتش**",
            "start": 452,
            "end": 496
          },
          {
            "id": "p9",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* لو سألتك: إذا كان لديك **6 شرائح خبز** وكمية كافية من الجبن، كم ساندويتش يمكنك أن تصنع؟",
            "start": 498,
            "end": 587
          },
          {
            "id": "p10",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* ستجيب فوراً: **3 ساندويتشات!**",
            "start": 588,
            "end": 620
          },
          {
            "id": "p11",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* ولو سألتك: كم شريحة جبن ستحتاج لهذه الساندويتشات الثلاثة؟",
            "start": 621,
            "end": 680
          },
          {
            "id": "p12",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* ستجيب: **3 شرائح جبن.**",
            "start": 681,
            "end": 706
          },
          {
            "id": "p13",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "ما فعلته بعقلك الآن هو بالضبط **علم الاستوكيومتري**! أنت حسبت كميات المواد التي تحتاجها لإنتاج كمية معينة من الناتج.",
            "start": 708,
            "end": 824
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The sandwich analogy accurately mirrors stoichiometry: proportional reactant consumption yielding a predictable product amount.",
          "errors": []
        }
      },
