            "id": "p22",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - الكتلة المولية لـ H₂ = 2 جم/مول",
            "start": 1364,
            "end": 1400
          },
