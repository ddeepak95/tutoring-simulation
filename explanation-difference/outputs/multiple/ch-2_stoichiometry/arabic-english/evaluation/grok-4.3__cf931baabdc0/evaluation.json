            "id": "p23",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - عدد المولات = الكتلة ÷ الكتلة المولية = 8 ÷ 2 = **4 مول** من H₂",
            "start": 1401,
            "end": 1469
          },
          {
            "id": "p24",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "2. استخدم نسبة المولات من المعادلة:",
            "start": 1471,
            "end": 1506
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - من المعادلة: 2 مول H₂ → 2 مول H₂O",
            "start": 1507,
            "end": 1545
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - إذن 4 مول H₂ → **4 مول** H₂O",
            "start": 1546,
            "end": 1579
          },
          {
            "id": "p27",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "3. حوّل المولات إلى كتلة:",
            "start": 1581,
            "end": 1606
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - الكتلة المولية لـ H₂O = 18 جم/مول",
            "start": 1607,
            "end": 1645
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "   - الكتلة = عدد المولات × الكتلة المولية = 4 × 18 = **72 جرام**",
