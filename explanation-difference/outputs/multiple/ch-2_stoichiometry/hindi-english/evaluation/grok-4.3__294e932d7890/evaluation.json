            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 2 अणु हाइड्रोजन + 1 अणु ऑक्सीजन → 2 अणु पानी  ",
            "start": 786,
            "end": 834
          },
