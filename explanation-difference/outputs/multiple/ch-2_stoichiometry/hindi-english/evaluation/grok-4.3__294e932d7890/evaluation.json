            "review_flags": [],
            "text": "सबसे आसान उदाहरण लेते हैं — हाइड्रोजन गैस और ऑक्सीजन गैस से पानी बनना:",
            "start": 612,
            "end": 682
          },
          {
            "id": "p8",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**असंतुलित समीकरण:**  ",
