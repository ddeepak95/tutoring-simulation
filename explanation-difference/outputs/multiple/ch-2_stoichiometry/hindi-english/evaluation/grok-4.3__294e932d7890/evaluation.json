            "end": 706
          },
          {
            "id": "p9",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "H₂ + O₂ → H₂O",
            "start": 707,
            "end": 720
          },
          {
            "id": "p10",
