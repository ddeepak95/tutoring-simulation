            "text": "## 💡 مثال تطبيقي",
            "start": 984,
            "end": 1000
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**السؤال:** كم جرام من الأكسجين (O₂) نحتاج للتفاعل الكامل مع 4 جرام من الهيدروجين (H₂) لإنتاج الماء؟",
            "start": 1002,
            "end": 1102
          },
          {
            "id": "p26",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**المعادلة الموزونة:**",
            "start": 1104,
            "end": 1126
          },
          {
            "id": "p27",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$2H_2 + O_2 \\rightarrow 2H_2O$$",
            "start": 1127,
            "end": 1159
          },
          {
            "id": "p28",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**الحل:**",
            "start": 1161,
            "end": 1170
          },
          {
            "id": "p29",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**الخطوة 1:** حساب عدد مولات H₂",
            "start": 1172,
            "end": 1203
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$n(H_2) = \\frac{الكتلة}{الكتلة المولية} = \\frac{4}{2} = 2 \\text{ مول}$$",
            "start": 1204,
            "end": 1276
          },
          {
            "id": "p31",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**الخطوة 2:** استخدام النسبة المولية من المعادلة",
            "start": 1278,
            "end": 1326
          },
          {
            "id": "p32",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- النسبة بين H₂ و O₂ هي 2:1",
            "start": 1327,
            "end": 1354
          },
          {
            "id": "p33",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$n(O_2) = n(H_2) \\times \\frac{1}{2} = 2 \\times \\frac{1}{2} = 1 \\text{ مول}$$",
            "start": 1355,
            "end": 1432
          },
          {
            "id": "p34",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**الخطوة 3:** حساب كتلة O₂",
            "start": 1434,
            "end": 1460
          },
          {
            "id": "p35",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- الكتلة المولية لـ O₂ = 32 g/mol",
            "start": 1461,
            "end": 1494
          },
          {
            "id": "p36",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$الكتلة = n \\times الكتلة المولية = 1 \\times 32 = 32 \\text{ جرام}$$",
            "start": 1495,
            "end": 1563
          },
          {
            "id": "p37",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### ✅ الإجابة: نحتاج 32 جرام من الأكسجين",
            "start": 1565,
            "end": 1605
          },
          {
            "id": "p38",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1607,
            "end": 1610
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All calculations and steps are correct: n(H2) = 4 / 2 = 2 mol; n(O2) = 2 × (1/2) = 1 mol; mass(O2) = 1 × 32 = 32 g.",
