            "id": "p36",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "You can make 72 grams of water from 8 grams of hydrogen.",
            "start": 2200,
            "end": 2256
          }
        ],
        "accuracy": {
