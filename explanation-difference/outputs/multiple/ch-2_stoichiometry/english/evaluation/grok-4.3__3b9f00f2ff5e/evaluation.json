            "review_flags": [],
            "text": "### How Stoichiometry Works (Step by Step)",
            "start": 1379,
            "end": 1421
          },
          {
            "id": "p19",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "You always follow these steps:",
            "start": 1422,
