      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Definition of stoichiometry and baking recipe analogy",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Introduces the concept of stoichiometry as the quantitative relationship between reactants and products in a chemical reaction using a baking recipe analogy.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p1",
              "quote": "recipe in baking: if the recipe says \"2 cups flour + 1 cup sugar makes 12 cookies,\" you can scale it up or down to figure out how many cookies you'll get from 4 cups of flour."
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Stoichiometry is basically the \"math of chemistry.\" It helps you figure out exactly how much stuff (reactants) you need to make a certain amount of product in a chemical reaction—or how much product you can make from what you have. Think of it like a recipe in baking: if the recipe says \"2 cups flour + 1 cup sugar makes 12 cookies,\" you can scale it up or down to figure out how many cookies you'll get from 4 cups of flour.",
            "start": 0,
            "end": 426
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition and recipe analogy accurately capture the essence of stoichiometry for an introductory audience.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Conservation of mass, balanced equations, and mole ratios",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Explains why chemical reactions require balanced equations due to the law of conservation of mass, and illustrates how coefficients provide mole ratios using the formation of water.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Why We Need It",
            "start": 428,
            "end": 446
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Chemical reactions follow the law of conservation of mass—atoms are never created or destroyed, just rearranged. So we use **balanced chemical equations** to show the exact ratios of molecules involved.",
            "start": 447,
            "end": 649
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Example (unbalanced):",
            "start": 651,
            "end": 672
          },
          {
            "id": "p5",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "H₂ + O₂ → H₂O",
            "start": 673,
            "end": 686
          },
          {
            "id": "p6",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Balanced:",
            "start": 688,
            "end": 697
          },
          {
            "id": "p7",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "2H₂ + O₂ → 2H₂O",
            "start": 698,
            "end": 713
          },
          {
            "id": "p8",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "This tells us that **2 molecules of hydrogen** react with **1 molecule of oxygen** to make **2 molecules of water**. The numbers in front (called coefficients) give us the mole ratios.",
            "start": 715,
            "end": 899
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly links the law of conservation of mass to balancing equations and explains how stoichiometric coefficients represent mole and molecule ratios.",
          "errors": []
        }
      },
      {
        "id": "u3",
        "kind": "CONCEPT",
        "label": "The mole concept, Avogadro's number, and molar mass",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Defines the mole as a counting unit in chemistry, introduces Avogadro's number, explains molar mass, and demonstrates how to determine the molar mass of water.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p10",
              "quote": "just like a \"dozen\" = 12"
            }
          ]
        },
        "passages": [
          {
            "id": "p9",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### The Mole: Chemistry's Counting Unit",
            "start": 901,
            "end": 940
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Atoms and molecules are tiny, so we don't count them one by one. Instead, we use the **mole** (just like a \"dozen\" = 12).",
            "start": 941,
            "end": 1062
          },
          {
            "id": "p11",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 1 mole = 6.022 × 10²³ particles (Avogadro's number)",
            "start": 1064,
            "end": 1117
          },
          {
            "id": "p12",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- We convert between **grams** (what we can measure) and **moles** using molar mass (found on the periodic table).",
            "start": 1118,
            "end": 1232
          },
          {
            "id": "p13",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "For water (H₂O):",
            "start": 1234,
            "end": 1250
          },
          {
            "id": "p14",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- H = 1.008 g/mol × 2 = 2.016 g",
            "start": 1251,
            "end": 1282
          },
          {
            "id": "p15",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- O = 16.00 g/mol",
            "start": 1283,
            "end": 1300
          },
          {
            "id": "p16",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Total molar mass = 18.016 g/mol",
            "start": 1301,
            "end": 1334
          },
          {
            "id": "p17",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "So 1 mole of water weighs about 18 grams.",
            "start": 1336,
            "end": 1377
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of the mole, the value of Avogadro's number, and the calculation of the molar mass of water are correct within standard high school precision and pedagogical conventions.",
          "errors": []
        }
      },
