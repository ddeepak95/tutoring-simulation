              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## What is Stoichiometry?",
            "start": 35,
            "end": 60
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Stoichiometry (pronounced \"stoy-kee-OM-eh-tree\") is the branch of chemistry that deals with the **quantitative relationships** between reactants and products in a chemical reaction. Think of it as the \"math of chemistry\" — it helps us answer questions like:",
            "start": 62,
            "end": 319
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- How much product will I get?",
            "start": 321,
            "end": 351
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- How much reactant do I need?",
            "start": 352,
            "end": 382
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Will I have leftover materials?",
            "start": 383,
            "end": 416
          },
          {
            "id": "p7",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 418,
            "end": 421
          }
        ],
