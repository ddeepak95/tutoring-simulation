        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p33",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Worked Example",
            "start": 1590,
            "end": 1607
          },
          {
            "id": "p34",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Question:** How many grams of water are produced when 4 grams of H₂ react completely with excess O₂?",
            "start": 1609,
            "end": 1711
          },
          {
            "id": "p35",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "prose"
            ],
            "review_flags": [],
            "text": "**Reaction:** $2H_2 + O_2 \\rightarrow 2H_2O$",
            "start": 1713,
            "end": 1757
          },
          {
            "id": "p36",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**Step 1: Convert grams of H₂ to moles**",
            "start": 1759,
            "end": 1799
          },
          {
            "id": "p37",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$4 \\text{ g H}_2 \\times \\frac{1 \\text{ mol H}_2}{2 \\text{ g H}_2} = 2 \\text{ mol H}_2$$",
            "start": 1800,
            "end": 1888
          },
          {
            "id": "p38",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**Step 2: Use mole ratio to find moles of H₂O**",
            "start": 1890,
            "end": 1937
          },
          {
            "id": "p39",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$2 \\text{ mol H}_2 \\times \\frac{2 \\text{ mol H}_2O}{2 \\text{ mol H}_2} = 2 \\text{ mol H}_2O$$",
            "start": 1938,
            "end": 2032
          },
          {
            "id": "p40",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**Step 3: Convert moles of H₂O to grams**",
            "start": 2034,
            "end": 2075
          },
          {
            "id": "p41",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$2 \\text{ mol H}_2O \\times \\frac{18 \\text{ g H}_2O}{1 \\text{ mol H}_2O} = 36 \\text{ g H}_2O$$",
            "start": 2076,
            "end": 2170
          },
          {
            "id": "p42",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Answer: 36 grams of water** ✅",
            "start": 2172,
            "end": 2203
          },
          {
            "id": "p43",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 2205,
            "end": 2208
          }
        ],
        "accuracy": {
