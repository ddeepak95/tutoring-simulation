      {
        "id": "u5",
        "kind": "EXAMPLE",
        "label": "Worked Example: Gram-to-Gram Water Formation",
        "attributes": {
          "context": "abstract_or_hypothetical",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s5"
        ],
        "rationale": "Works through a complete numerical problem calculating the mass of water produced from a given mass of hydrogen gas.",
