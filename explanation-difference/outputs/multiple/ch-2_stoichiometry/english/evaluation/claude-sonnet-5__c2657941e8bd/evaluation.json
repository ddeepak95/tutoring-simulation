      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Balanced Chemical Equations as the Foundation",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Explains why balanced chemical equations are essential for stoichiometry based on the Law of Conservation of Mass and demonstrates how coefficients provide mole ratios.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p8",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## The Foundation: Balanced Equations",
            "start": 423,
            "end": 460
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Before doing any stoichiometry, you need a **balanced chemical equation**. This is crucial because of the **Law of Conservation of Mass** — matter cannot be created or destroyed.",
            "start": 462,
            "end": 640
          },
          {
            "id": "p10",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**Example:**",
            "start": 642,
            "end": 654
          },
          {
            "id": "p11",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$2H_2 + O_2 \\rightarrow 2H_2O$$",
            "start": 655,
            "end": 687
          },
          {
            "id": "p12",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "This tells us:",
            "start": 689,
            "end": 703
          },
          {
            "id": "p13",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 2 molecules of hydrogen react with 1 molecule of oxygen",
            "start": 704,
            "end": 761
          },
          {
            "id": "p14",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- to produce 2 molecules of water",
            "start": 762,
            "end": 795
          },
          {
            "id": "p15",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The coefficients (2, 1, 2) give us **mole ratios** — the key to all stoichiometry calculations.",
            "start": 797,
            "end": 892
          },
          {
            "id": "p16",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 894,
            "end": 897
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately connects the requirement for balanced equations to the Law of Conservation of Mass and describes how reaction coefficients establish mole ratios.",
          "errors": []
        }
      },
      {
        "id": "u3",
        "kind": "CONCEPT",
        "label": "The Mole Concept and Mole Ratios",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Explains the definition of a mole as chemistry's counting unit and demonstrates how balanced equation coefficients translate to mole relationships.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p17",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Key Concept: The Mole",
            "start": 899,
            "end": 923
          },
          {
            "id": "p18",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The **mole** is chemistry's counting unit (like \"dozen\" = 12, \"mole\" = 6.022 × 10²³ particles).",
            "start": 925,
            "end": 1020
          },
          {
            "id": "p19",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Stoichiometry works because coefficients in a balanced equation represent **mole ratios**, not just molecule ratios.",
            "start": 1022,
            "end": 1138
          },
          {
            "id": "p20",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "So in $2H_2 + O_2 \\rightarrow 2H_2O$:",
            "start": 1140,
            "end": 1177
          },
          {
            "id": "p21",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 2 moles H₂ react with 1 mole O₂ to give 2 moles H₂O",
            "start": 1178,
            "end": 1231
          },
          {
            "id": "p22",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1233,
            "end": 1236
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly defines the mole (including Avogadro's number) and explains its role in stoichiometry calculations via mole ratios.",
          "errors": []
        }
      },
