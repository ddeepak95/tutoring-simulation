        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p7",
              "quote": "মনে করো, তুমি ডিমের অমলেট বানাবে।"
            },
            {
              "passage_id": "p8",
              "quote": "১টি ডিম + ১ চিমটি লবণ = ১টি অমলেট"
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "হ্যালো! কেমন আছো? রসায়ন বিষয়টাকে অনেকে একটু ভয় পায়, কিন্তু সত্যি বলতে রসায়ন আসলে রান্নাবান্নার মতোই মজার একটা বিষয়! ",
            "start": 0,
            "end": 116
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "আজকে আমরা রসায়নের খুবই গুরুত্বপূর্ণ এবং মজার একটা টপিক নিয়ে কথা বলব, যার নাম **“রাসায়নিক সমীকরণমিতি” (Stoichiometry)**। নামটা শুনে বেশ কঠিন আর ভারী মনে হলেও, আসল ব্যাপারটা কিন্তু দারুণ সহজ! ",
            "start": 118,
            "end": 309
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "চলো, একদম সহজ করে বিষয়টা বুঝে নেওয়া যাক।",
            "start": 311,
            "end": 351
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
