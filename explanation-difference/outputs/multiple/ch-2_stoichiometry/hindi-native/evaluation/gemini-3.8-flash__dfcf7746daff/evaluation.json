      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Definition and etymology of stoichiometry",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Defines stoichiometry as the quantitative relationship between reactants and products in a chemical reaction and explains its Greek etymology.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p11",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "बस! यही **रससमीकरणमिति (Stoichiometry)** है। ",
            "start": 595,
            "end": 640
          },
          {
            "id": "p12",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* **परिभाषा:** रसायन विज्ञान में, किसी रासायनिक अभिक्रिया (Chemical Reaction) में भाग लेने वाले पदार्थों (अभिकारक/Reactants) और बनने वाले पदार्थों (उत्पाद/Products) की मात्रा के हिसाब-किताब को ही **रससमीकरणमिति** कहते हैं। इसे आप **\"केमिस्ट्री की रेसिपी\"** कह सकते हैं।",
            "start": 641,
            "end": 910
          },
          {
            "id": "p13",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "*(यह शब्द ग्रीक भाषा के दो शब्दों से बना है: 'Stoicheion' यानी तत्व और 'Metron' यानी मापना।)*",
            "start": 912,
            "end": 1005
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of stoichiometry and the Greek etymology ('stoicheion' meaning element and 'metron' meaning measure) are factually correct.",
          "errors": []
        }
      },
      {
