            "review_flags": [],
            "text": "### 3. यह ग्राम (द्रव्यमान) में कैसे काम करता है?",
            "start": 1906,
            "end": 1955
          },
          {
            "id": "p27",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "आइए उसी पानी वाले उदाहरण को ग्राम में देखें:",
            "start": 1957,
            "end": 2001
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* $H_2$ (हाइड्रोजन) का मोलर द्रव्यमान = 2 ग्राम। तो $2H_2$ = $2 \\times 2 = 4$ ग्राम।",
            "start": 2002,
            "end": 2086
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* $O_2$ (ऑक्सीजन) का मोलर द्रव्यमान = 32 ग्राम।",
            "start": 2087,
            "end": 2134
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "* $H_2O$ (पानी) का मोलर द्रव्यमान = 18 ग्राम। तो $2H_2O$ = $2 \\times 18 = 36$ ग्राम।",
            "start": 2135,
            "end": 2219
          },
          {
            "id": "p31",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "समीकरण के अनुसार:",
            "start": 2221,
            "end": 2238
          },
          {
            "id": "p32",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**4 ग्राम हाइड्रोजन + 32 ग्राम ऑक्सीजन = 36 ग्राम पानी**",
            "start": 2239,
            "end": 2295
          },
          {
            "id": "p33",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "जाँचिए: ",
            "start": 2297,
            "end": 2305
          },
          {
            "id": "p34",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "बाएँ हाथ की तरफ कुल भार = $4 + 32 = 36$ ग्राम।",
            "start": 2306,
            "end": 2352
          },
          {
            "id": "p35",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "दाएँ हाथ की तरफ कुल भार = $36$ ग्राम।",
            "start": 2353,
            "end": 2390
          },
          {
            "id": "p36",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "हिसाब बिल्कुल पक्का है!",
            "start": 2391,
            "end": 2414
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All molar masses (H2 = 2 g/mol, O2 = 32 g/mol, H2O = 18 g/mol) and the mass balance (4 g + 32 g = 36 g) are correctly calculated.",
          "errors": []
        }
      },
