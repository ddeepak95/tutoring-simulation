            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Interprétation :",
            "start": 1139,
            "end": 1155
          },
          {
            "id": "p15",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
