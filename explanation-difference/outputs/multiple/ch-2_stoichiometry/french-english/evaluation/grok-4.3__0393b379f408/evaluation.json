            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "- Pour former 2 molécules d’eau (H₂O)",
            "start": 1229,
            "end": 1266
          },
          {
            "id": "p17",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "En termes de **moles** (l’unité de quantité de matière) :",
            "start": 1268,
            "end": 1325
          },
          {
            "id": "p18",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "- Rapport molaire = **2 : 1 : 2**",
            "start": 1326,
            "end": 1359
          },
