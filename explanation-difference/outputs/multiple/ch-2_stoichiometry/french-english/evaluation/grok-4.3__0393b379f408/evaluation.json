            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Avant tout calcul, l’équation doit être **équilibrée** (le nombre d’atomes de chaque élément doit être le même à gauche et à droite).",
            "start": 932,
            "end": 1065
          },
          {
            "id": "p10",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Exemple classique :",
            "start": 1067,
            "end": 1086
          },
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 1087,
