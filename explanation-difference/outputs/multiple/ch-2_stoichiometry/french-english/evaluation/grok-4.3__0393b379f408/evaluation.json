            "end": 1557
          },
          {
            "id": "p22",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Exemple** : Combien de grammes d’eau peut-on obtenir avec 8 g d’hydrogène (H₂) ?",
            "start": 1559,
            "end": 1641
          },
          {
            "id": "p23",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "1. Calculer le nombre de moles d’H₂ :",
            "start": 1643,
            "end": 1680
          },
          {
            "id": "p24",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   - Masse molaire de H₂ = 2 g/mol",
            "start": 1681,
            "end": 1715
          },
          {
            "id": "p25",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   - \\( n = \\frac{m}{M} = \\frac{8}{2} = 4 \\) moles d’H₂",
            "start": 1716,
            "end": 1771
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "2. Utiliser le rapport : 2 moles d’H₂ → 2 moles d’H₂O (rapport 1:1)",
            "start": 1773,
            "end": 1840
          },
          {
            "id": "p27",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   - Donc 4 moles d’H₂ donnent **4 moles** d’H₂O",
            "start": 1841,
            "end": 1889
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "3. Calculer la masse d’eau :",
            "start": 1891,
            "end": 1919
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   - Masse molaire de H₂O = 18 g/mol",
            "start": 1920,
            "end": 1956
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "   - \\( m = n \\times M = 4 \\times 18 = 72 \\) g d’eau",
            "start": 1957,
            "end": 2009
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "All calculations (molar masses, mole conversions, mole ratios, final mass of 72 g) are correct.",
          "errors": []
        }
