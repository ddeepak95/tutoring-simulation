        "passages": [
          {
            "id": "p25",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Exemple concret",
            "start": 1247,
            "end": 1265
          },
          {
            "id": "p26",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Question :** Combien de grammes d'eau obtient-on à partir de 4g de dihydrogène (H₂) ?",
            "start": 1267,
            "end": 1354
          },
          {
            "id": "p27",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Étape 1 :** L'équation est déjà équilibrée :",
            "start": 1356,
            "end": 1402
          },
          {
            "id": "p28",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$2H_2 + O_2 \\rightarrow 2H_2O$$",
            "start": 1403,
            "end": 1435
          },
          {
            "id": "p29",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Étape 2 :** Calculer les moles de H₂",
            "start": 1437,
            "end": 1475
          },
          {
            "id": "p30",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$n(H_2) = \\frac{4g}{2g/mol} = 2 \\text{ mol}$$",
            "start": 1476,
            "end": 1522
          },
          {
            "id": "p31",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Étape 3 :** Utiliser le rapport stœchiométrique",
            "start": 1524,
            "end": 1573
          },
          {
            "id": "p32",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "D'après l'équation : 2 mol H₂ → 2 mol H₂O (rapport 1:1)",
            "start": 1574,
            "end": 1629
          },
          {
            "id": "p33",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Donc : n(H₂O) = 2 mol",
            "start": 1631,
            "end": 1652
          },
          {
            "id": "p34",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Étape 4 :** Convertir en grammes",
            "start": 1654,
            "end": 1688
          },
          {
            "id": "p35",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$m(H_2O) = n \\times M = 2 \\times 18 = 36g$$",
            "start": 1689,
            "end": 1733
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Calculations and conversions are fully correct: 4 g / 2 g/mol = 2 mol H2; 2 mol H2 produces 2 mol H2O; 2 mol * 18 g/mol = 36 g H2O.",
          "errors": []
        }
