            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1️⃣ Équilibrer l'équation chimique",
            "start": 792,
            "end": 830
          },
          {
            "id": "p14",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Vérifier que le nombre d'atomes est le même de chaque côté.",
            "start": 831,
            "end": 890
          },
          {
            "id": "p15",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 2️⃣ Convertir en moles",
            "start": 892,
            "end": 918
          },
          {
            "id": "p16",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Utiliser la formule :",
            "start": 919,
            "end": 940
          },
          {
            "id": "p17",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$n = \\frac{m}{M}$$",
            "start": 941,
            "end": 960
          },
          {
            "id": "p18",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "où :",
            "start": 962,
            "end": 966
          },
          {
            "id": "p19",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- *n* = quantité de matière (en mol)",
            "start": 967,
            "end": 1003
          },
          {
            "id": "p20",
            "category": "PROCEDURE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- *m* = masse (en g)",
            "start": 1004,
            "end": 1024
          },
