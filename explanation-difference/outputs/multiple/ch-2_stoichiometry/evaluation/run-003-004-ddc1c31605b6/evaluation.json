            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "வேதியியல் சமன்பாடு சரியாக balance ஆகி இருக்க வேண்டும் (இரு பக்கமும் atoms எண்ணிக்கை சமமாக இருக்க வேண்டும்)",
            "start": 665,
