            "id": "p22",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "4. **Formation of oxides and hydroxides**: They form oxides and hydroxides when exposed to air and water.",
            "start": 1531,
            "end": 1636
          }
        ],
        "accuracy": {
