        "passages": [
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "These elements are called \"alkaline earth metals\" because they are less reactive than the alkali metals (Group 1) and are typically found in the earth's crust.",
            "start": 404,
            "end": 563
          }
        ],
        "accuracy": {
          "verdict": "contains_error",
          "reason": "The historical etymology is incorrect: they were termed 'alkaline earths' by alchemists because their oxides ('earths', an archaic term for nonmetallic mineral oxides insoluble in water and stable to heat) produced basic/alkaline solutions, not because they are less reactive than alkali metals.",
          "errors": [
            {
              "passage_ids": [
                "p10"
              ],
              "description": "States that the elements are called 'alkaline earth metals' because they are less reactive than alkali metals and typically found in the earth's crust.",
              "correction": "The name comes from the old chemical term 'earths' applied to their oxides, which remained unchanged by fire and formed basic (alkaline) solutions in water.",
              "severity": "minor"
            }
          ]
        }
