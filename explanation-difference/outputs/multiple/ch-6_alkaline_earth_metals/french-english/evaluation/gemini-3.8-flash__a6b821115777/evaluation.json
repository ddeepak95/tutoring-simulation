            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Tu vas voir, une fois qu'on a compris comment ils fonctionnent, tout devient très logique.",
            "start": 143,
            "end": 233
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
