        "rationale": "Explains why group 2 elements share chemical behavior based on having two valence electrons and losing them to form +2 cations.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p15",
            "category": "ORGANIZATION",
