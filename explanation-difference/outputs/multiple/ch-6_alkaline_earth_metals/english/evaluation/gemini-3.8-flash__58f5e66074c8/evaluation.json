            ],
            "review_flags": [],
            "text": "Think of them as the slightly calmer, more grounded younger siblings of the wild Alkali Metals in Group 1. ",
            "start": 136,
            "end": 243
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
