              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le rayon covalent varie selon la position de l’élément dans le tableau périodique.",
            "start": 1026,
            "end": 1108
          },
          {
            "id": "p23",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **De gauche à droite dans une période** : le rayon covalent diminue généralement.  ",
            "start": 1110,
            "end": 1195
          },
          {
            "id": "p24",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  Les protons sont plus nombreux dans le noyau, qui attire plus fortement les électrons.",
            "start": 1196,
            "end": 1284
          },
          {
            "id": "p25",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **De haut en bas dans une colonne** : le rayon covalent augmente généralement.  ",
            "start": 1286,
            "end": 1368
          },
          {
            "id": "p26",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  Les atomes possèdent davantage de couches électroniques, donc ils deviennent plus grands.",
            "start": 1369,
            "end": 1460
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The stated periodic trends (decrease across a period due to increased effective nuclear charge, increase down a group due to additional shells) are scientifically sound.",
