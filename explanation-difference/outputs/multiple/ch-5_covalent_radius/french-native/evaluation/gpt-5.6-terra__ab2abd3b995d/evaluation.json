    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Définition et mesure du rayon covalent",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains why atomic boundaries cannot be measured directly and how covalent radius is defined as half the internuclear distance between two identical bonded atoms.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le **rayon covalent** est une mesure qui donne une idée de la taille d’un atome lorsqu’il est lié à un autre atome par une **liaison covalente**.",
            "start": 0,
            "end": 145
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Définition",
            "start": 147,
            "end": 161
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Une liaison covalente se forme lorsque deux atomes **partagent des électrons**.",
            "start": 163,
            "end": 242
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "On ne peut pas vraiment mesurer le « bord » d’un atome, car le nuage électronique n’a pas de limite nette. Pour définir sa taille, on utilise donc la distance entre les noyaux de deux atomes liés.",
            "start": 244,
            "end": 440
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Pour deux atomes identiques liés entre eux :",
            "start": 442,
            "end": 486
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 488,
            "end": 490
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{rayon covalent} = \\frac{\\text{distance entre les deux noyaux}}{2}",
            "start": 491,
            "end": 562
          },
          {
            "id": "p8",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 563,
            "end": 565
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of the covalent radius as half the distance between the nuclei of two identical bonded atoms is standard and correct.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "EXAMPLE",
        "label": "Calcul du rayon covalent de l'hydrogène dans H2",
        "attributes": {
          "context": "abstract_or_hypothetical",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Walks through a step-by-step numerical calculation of the covalent radius of hydrogen using the bond length in dihydrogen.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p9",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Exemple : la molécule de dihydrogène \\(H_2\\)",
            "start": 567,
            "end": 615
          },
          {
            "id": "p10",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Dans la molécule \\(H_2\\), deux atomes d’hydrogène sont liés par une liaison covalente.",
            "start": 617,
            "end": 703
          },
          {
            "id": "p11",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "La distance entre leurs noyaux est d’environ **74 pm** (picomètres).",
            "start": 705,
            "end": 773
          },
          {
            "id": "p12",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 775,
            "end": 777
          },
          {
            "id": "p13",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "1\\ \\text{pm} = 10^{-12}\\ \\text{m}",
            "start": 778,
            "end": 811
          },
          {
            "id": "p14",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 812,
            "end": 814
          },
          {
            "id": "p15",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Donc le rayon covalent de l’hydrogène vaut environ :",
            "start": 816,
            "end": 868
          },
          {
            "id": "p16",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 870,
            "end": 872
          },
          {
            "id": "p17",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\frac{74}{2} = 37\\ \\text{pm}",
            "start": 873,
            "end": 901
          },
          {
            "id": "p18",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation",
              "separator"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 902,
            "end": 904
          },
          {
            "id": "p19",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Chaque atome d’hydrogène « occupe » donc environ 37 pm dans la liaison.",
            "start": 906,
            "end": 977
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The bond length of 74 pm for H2 and the resulting covalent radius of 37 pm are physically accurate and correctly computed.",
          "errors": []
        }
