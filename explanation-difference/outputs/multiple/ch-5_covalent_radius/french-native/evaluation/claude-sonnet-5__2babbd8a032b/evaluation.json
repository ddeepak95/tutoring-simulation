            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Définition simple",
            "start": 21,
            "end": 41
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le **rayon covalent** représente la taille d'un atome lorsqu'il est engagé dans une **liaison covalente** avec un autre atome (une liaison où deux atomes partagent une paire d'électrons).",
            "start": 43,
            "end": 230
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The statement accurately introduces the covalent radius in the context of a shared electron pair in a covalent bond.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "PROCEDURE",
        "label": "Procedure for measuring covalent radius",
        "attributes": {},
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Describes the two-step protocol used to determine covalent radius by halving the internuclear distance between two identical bonded atoms.",
        "review_flags": [],
        "contextualization": {
