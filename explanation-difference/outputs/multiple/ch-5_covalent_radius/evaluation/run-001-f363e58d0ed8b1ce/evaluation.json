    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Definition of covalent radius",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains what covalent radius is, why internuclear distance is used instead of direct atomic edges, and gives the standard formal definition.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Covalent radius** is a measure of the size of an atom when it is joined to another atom by a **covalent bond**.",
            "start": 0,
            "end": 113
          },
          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "A covalent bond forms when two atoms **share electrons**. Because atoms do not have sharp outer edges, scientists cannot directly measure the “edge” of one atom. Instead, they use the distance between the nuclei of two bonded atoms.",
            "start": 115,
            "end": 347
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Definition",
            "start": 349,
            "end": 363
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The covalent radius of an atom is:",
            "start": 364,
            "end": 398
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **Half the distance between the nuclei of two identical atoms joined by a single covalent bond.**",
            "start": 400,
            "end": 499
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition correctly specifies half the internuclear distance between identical atoms joined by a single covalent bond.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "EXAMPLE",
        "label": "Chlorine molecule covalent radius calculation",
        "attributes": {
          "context": "abstract_or_hypothetical",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s2"
        ],
        "rationale": "Walks through a calculation of the covalent radius of chlorine from the internuclear distance in Cl2.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p6",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "For example, in a chlorine molecule, Cl₂, the two chlorine atoms are joined by a covalent bond. If the distance between their nuclei is 198 pm (picometres), then:",
            "start": 501,
            "end": 663
          },
          {
            "id": "p7",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 665,
            "end": 667
          },
          {
            "id": "p8",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{Covalent radius of Cl} = \\frac{198}{2} = 99\\text{ pm}",
            "start": 668,
            "end": 727
          },
          {
            "id": "p9",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 728,
            "end": 730
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "A **picometre (pm)** is \\(10^{-12}\\) metres, so atomic radii are extremely small.",
            "start": 732,
            "end": 813
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The internuclear distance of 198 pm in Cl2 correctly yields a covalent radius of 99 pm, and the definition of picometre is accurate.",
          "errors": []
        }
      },
      {
