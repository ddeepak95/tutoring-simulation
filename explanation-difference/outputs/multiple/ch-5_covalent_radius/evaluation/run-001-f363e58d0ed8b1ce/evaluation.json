        "rationale": "Explains the periodic trends across periods and down groups, including nuclear charge and electron shielding/shells.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Trends in the periodic table",
            "start": 815,
            "end": 847
          },
          {
            "id": "p12",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "- **Across a period (left to right):** covalent radius generally **decreases**.  ",
            "start": 849,
            "end": 930
          },
          {
            "id": "p13",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  This happens because the number of protons increases, pulling the outer electrons closer to the nucleus.",
            "start": 931,
            "end": 1037
          },
          {
            "id": "p14",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list",
              "prose"
            ],
            "review_flags": [],
            "text": "- **Down a group (top to bottom):** covalent radius generally **increases**.  ",
            "start": 1039,
            "end": 1117
          },
          {
            "id": "p15",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  This is because each element has an additional electron shell, making the atom larger.",
            "start": 1118,
            "end": 1206
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly states and explains why covalent radius decreases across a period and increases down a group.",
          "errors": []
        }
      },
      {
