            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{सहसंयोजक त्रिज्या} = \\frac{\\text{दो परमाणुओं के नाभिकों के बीच की दूरी}}{2}$$",
            "start": 306,
            "end": 391
          }
        ],
        "accuracy": {
