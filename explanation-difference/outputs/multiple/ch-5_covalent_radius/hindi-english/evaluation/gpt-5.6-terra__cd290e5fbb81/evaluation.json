            "end": 282
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "यदि दो समान परमाणुओं के नाभिकों के बीच की दूरी = \\(d\\)",
            "start": 283,
