        ],
        "rationale": "Defines covalent radius as half of the internuclear distance between two identical bonded non-metal atoms and provides the corresponding formula.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p6",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### **Covalent Radius की परिभाषा (Definition):**",
            "start": 518,
            "end": 566
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "जब दो एक जैसे (identical) नॉन-मेटल एटम्स आपस में **Single Covalent Bond (एकल सहसंयोजक बंध)** द्वारा जुड़े होते हैं, तो **दोनों एटम्स के नाभिकों (nuclei) के बीच की दूरी के आधे (half) भाग को Covalent Radius कहते हैं।**",
            "start": 568,
            "end": 784
          },
          {
            "id": "p8",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **आसान फॉर्मूला:**",
            "start": 786,
            "end": 806
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation",
              "prose"
            ],
            "review_flags": [],
            "text": "> **$r_{\\text{cov}} = \\frac{d}{2}$**",
            "start": 807,
            "end": 843
          },
          {
            "id": "p10",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> *(यहाँ $d$ = दोनों नाभिकों के बीच की दूरी, जिसे हम Bond Length भी कहते हैं)*",
            "start": 844,
            "end": 922
          },
          {
            "id": "p11",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 924,
            "end": 927
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The standard homonuclear single-bond definition and formula r_cov = d/2 are accurately stated.",
          "errors": []
        }
      },
