          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "عندما ترتبط ذرتان متماثلتان برابطة تساهمية، نقيس المسافة بين مركزي نواتيهما، ثم نقسمها على 2.",
            "start": 101,
            "end": 194
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
