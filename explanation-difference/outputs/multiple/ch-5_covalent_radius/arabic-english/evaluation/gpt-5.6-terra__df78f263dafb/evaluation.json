            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{نصف القطر التساهمي} = \\frac{\\text{المسافة بين نواتي ذرتين متماثلتين مرتبطتين}}{2}",
            "start": 199,
            "end": 286
          },
