          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "যখন একই মৌলের দুটি পরমাণু **সমযোজী বন্ধন** (covalent bond) তৈরি করে, তখন তাদের নিউক্লিয়াস দুটির মধ্যবর্তী দূরত্বের অর্ধেককে প্রতিটি পরমাণুর সমযোজী ব্যাসার্ধ বলা হয়।",
            "start": 89,
            "end": 255
          },
