            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Attention",
            "start": 1577,
            "end": 1590
          },
          {
            "id": "p30",
            "category": "CAVEAT",
            "attributes": {
              "subtype": "limitation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le rayon covalent n’est pas une frontière parfaitement nette de l’atome : le nuage électronique n’a pas de bord précis. C’est donc une grandeur définie à partir de mesures de distances dans les molécules.",
            "start": 1592,
            "end": 1796
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly states the quantum-mechanical limitation that electron density has no sharp cutoff, making atomic radii empirical/operational constructs.",
