        },
        "passages": [
          {
            "id": "p24",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Évolution dans le tableau périodique",
            "start": 1189,
            "end": 1229
          },
          {
            "id": "p25",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **De gauche à droite dans une période**, le rayon covalent diminue généralement.  ",
            "start": 1231,
            "end": 1315
          },
          {
            "id": "p26",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  Les noyaux ont de plus en plus de protons et attirent donc plus fortement les électrons.",
            "start": 1316,
            "end": 1406
          },
          {
            "id": "p27",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **De haut en bas dans une colonne**, le rayon covalent augmente généralement.  ",
            "start": 1408,
            "end": 1489
          },
          {
            "id": "p28",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "  Les atomes possèdent davantage de couches électroniques, donc ils sont plus grands.",
            "start": 1490,
            "end": 1575
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately describes both trends (decrease across periods due to increasing nuclear charge, increase down groups due to additional electron shells).",
          "errors": []
        }
      },
