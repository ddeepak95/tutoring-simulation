        },
        "passages": [
          {
            "id": "p20",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Par exemple, si le rayon covalent du carbone est environ \\(76\\ \\text{pm}\\) et celui de l’hydrogène environ \\(31\\ \\text{pm}\\), une liaison C–H mesure approximativement :",
            "start": 991,
            "end": 1159
          },
          {
            "id": "p21",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 1161,
            "end": 1163
          },
          {
            "id": "p22",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "76+31=107\\ \\text{pm}",
            "start": 1164,
            "end": 1184
          },
          {
            "id": "p23",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 1185,
            "end": 1187
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Using typical covalent radii of ~76 pm for C and ~31 pm for H gives ~107 pm, matching the observed typical single C-H bond length of around 107-109 pm.",
          "errors": []
        }
