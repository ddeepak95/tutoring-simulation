    "content_units": [
      {
        "id": "u1",
        "kind": "CONCEPT",
        "label": "Definition and formula of covalent radius",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Defines what a covalent bond and covalent radius are, and provides the formula based on half of the internuclear distance between two identical bonded atoms.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p1",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le **rayon covalent** est une mesure de la taille d’un atome lorsqu’il est lié à un autre atome par une **liaison covalente**.",
            "start": 0,
            "end": 126
          },
          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Une liaison covalente se forme lorsque deux atomes **partagent des électrons**. Par exemple, dans une molécule de dichlore \\(Cl_2\\), les deux atomes de chlore partagent une paire d’électrons.",
            "start": 128,
            "end": 319
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "On définit le rayon covalent ainsi :",
            "start": 321,
            "end": 357
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 359,
            "end": 361
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{rayon covalent} = \\frac{\\text{distance entre les noyaux de deux atomes identiques liés}}{2}",
            "start": 362,
            "end": 459
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 460,
            "end": 462
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of covalent radius as half the internuclear distance between two identical covalently bonded atoms is scientifically accurate.",
          "errors": []
        }
      },
      {
        "id": "u2",
        "kind": "EXAMPLE",
        "label": "Calculating the covalent radius of chlorine from Cl2",
        "attributes": {
          "context": "real_world",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Applies the definition to the dichlorine molecule (Cl2) with given internuclear distance to deduce the covalent radius of chlorine.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p7",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Par exemple, si la distance entre les deux noyaux dans \\(Cl_2\\) vaut \\(198\\ \\text{pm}\\) (picomètres), alors :",
            "start": 464,
            "end": 573
          },
          {
            "id": "p8",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 575,
            "end": 577
          },
          {
            "id": "p9",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "r_{\\text{covalent}}(Cl)=\\frac{198}{2}=99\\ \\text{pm}",
            "start": 578,
            "end": 629
          },
          {
            "id": "p10",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 630,
            "end": 632
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The experimental bond length of Cl2 is approximately 198 pm, yielding a covalent radius of 99 pm for chlorine.",
          "errors": []
        }
      },
      {
