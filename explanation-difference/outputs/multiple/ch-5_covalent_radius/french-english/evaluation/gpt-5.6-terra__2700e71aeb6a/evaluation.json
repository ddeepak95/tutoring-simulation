      {
        "id": "u4",
        "kind": "CONCEPT",
        "label": "Estimating bond length via covalent radii addition",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s3"
        ],
        "rationale": "Explains how covalent radii can be added together to estimate the bond length between two different atoms.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p15",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Pourquoi cette notion est-elle utile ?",
            "start": 694,
            "end": 736
          },
          {
            "id": "p16",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le rayon covalent permet de comparer la taille des atomes et d’estimer la longueur des liaisons chimiques. En général, pour une liaison simple entre deux atomes A et B :",
            "start": 738,
            "end": 907
          },
          {
            "id": "p17",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\[",
            "start": 909,
            "end": 911
          },
          {
            "id": "p18",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\text{longueur de liaison A-B} \\approx r_{\\text{cov}}(A)+r_{\\text{cov}}(B)",
            "start": 912,
            "end": 986
          },
          {
            "id": "p19",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "\\]",
            "start": 987,
            "end": 989
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The additivity of covalent radii as an approximation of single bond length is standard chemical practice.",
          "errors": []
        }
      },
      {
        "id": "u5",
        "kind": "EXAMPLE",
        "label": "Estimating the C-H bond length",
        "attributes": {
          "context": "real_world",
