              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Le **rayon covalent** est la moitié de la distance qui sépare les noyaux de deux atomes identiques liés par une liaison covalente simple.",
            "start": 36,
            "end": 173
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$r_{covalent} = \\frac{d_{A-A}}{2}$$",
            "start": 175,
            "end": 211
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Où **d** représente la distance internucléaire mesurée entre les deux atomes.",
            "start": 213,
            "end": 290
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition and formula correctly reflect standard introductory chemistry conventions for homonuclear single-bonded diatomic molecules.",
          "errors": []
        }
      },
