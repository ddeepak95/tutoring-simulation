        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p4",
              "quote": "Imagine que tu veuilles mesurer la taille d'une bille en verre : c'est facile, elle a un bord net."
            },
            {
              "passage_id": "p5",
