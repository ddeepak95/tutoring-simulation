            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "தேர்வுக்கு இது மிக முக்கியம், கவனமாகக் கேளுங்கள்:",
            "start": 1703,
