            ],
            "review_flags": [],
            "text": "# Covalent Radius",
            "start": 0,
            "end": 17
          },
          {
            "id": "p2",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Definition",
            "start": 19,
            "end": 32
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Covalent radius** is defined as **half the distance between the nuclei of two identical atoms that are joined together by a single covalent bond**.",
            "start": 34,
            "end": 183
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## A Simple Way to Picture It",
            "start": 185,
            "end": 214
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine two identical atoms bonded together, like in a chlorine molecule (Cl–Cl). If you measure the distance between the centers (nuclei) of the two chlorine atoms, and then divide that distance by 2, you get the covalent radius of chlorine.",
            "start": 216,
            "end": 458
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{Covalent radius} = \\frac{\\text{Distance between nuclei of bonded atoms}}{2}$$",
            "start": 460,
            "end": 545
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition and calculation formula for covalent radius are standard and scientifically accurate.",
          "errors": []
        }
      },
