            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{सहसंयोजक त्रिज्या } (r) = \\frac{\\text{दोनों नाभिकों के बीच की दूरी } (d)}{2}$$",
            "start": 1084,
            "end": 1170
          },
          {
            "id": "p12",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
