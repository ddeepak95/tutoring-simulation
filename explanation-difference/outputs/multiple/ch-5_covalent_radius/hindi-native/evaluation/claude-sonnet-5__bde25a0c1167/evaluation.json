            },
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{सहसंयोजक त्रिज्या} = \\frac{\\text{दोनों परमाणुओं के नाभिकों के बीच की दूरी}}{2}$$",
            "start": 239,
            "end": 327
          },
