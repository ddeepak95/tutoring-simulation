            ],
            "review_flags": [],
            "text": "## 2. Définition de la mole",
            "start": 474,
            "end": 501
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**La mole (mol)** est l'unité de mesure de la **quantité de matière** dans le Système International.",
            "start": 503,
            "end": 603
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **1 mole = 6,022 × 10²³ entités** (atomes, molécules, ions, électrons...)",
            "start": 605,
            "end": 680
          },
          {
            "id": "p8",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Ce nombre s'appelle le **nombre d'Avogadro** (noté N_A), en l'honneur du scientifique Amedeo Avogadro.",
            "start": 682,
            "end": 784
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Accurately defines 1 mole as 6.022 × 10²³ entities and correctly names Avogadro's number.",
          "errors": []
        }
      },
