          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "\"மோல்\" என்பது ஒரு அளவீட்டு அலகு. இது ஒரு பொருளின் அளவை குறிக்கப் பயன்படுகிறது. ஒரு மோல் என்பது ஒரு பொருளின் 6.022 x 10^23 துகள்களைக் (அணுக்கள் அல்லது மூலக்கூறுகள்) குறிக்கும்.",
            "start": 139,
            "end": 314
          },
