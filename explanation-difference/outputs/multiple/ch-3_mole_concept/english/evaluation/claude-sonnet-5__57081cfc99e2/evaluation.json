        "id": "u1",
        "kind": "CONCEPT",
        "label": "Why Chemists Need the Mole",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains why a macroscopic counting unit is necessary when dealing with microscopic particles, drawing parallels to everyday grouping units such as dozens and pairs.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p3",
              "quote": "Imagine trying to count grains of sand on a beach one by one — impossible, right?"
            },
            {
              "passage_id": "p5",
              "quote": "- **1 dozen** = 12 items"
            }
          ]
        },
        "passages": [
          {
            "id": "p1",
