      {
        "id": "u6",
        "kind": "EXAMPLE",
        "label": "Worked Problem: Calculating Atoms from Mass of Carbon",
        "attributes": {
          "context": "abstract_or_hypothetical",
          "treatment": "worked"
        },
        "subtopic_ids": [
          "s5"
        ],
        "rationale": "Presents a step-by-step worked problem calculating the number of carbon atoms in a given mass (24 g).",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p45",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "## Worked Example",
            "start": 2033,
            "end": 2050
          },
          {
            "id": "p46",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Question:** How many atoms are present in 24 grams of Carbon? (Atomic mass of C = 12)",
            "start": 2052,
            "end": 2139
          },
          {
            "id": "p47",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Step 1:** Find moles of Carbon",
            "start": 2141,
            "end": 2173
          },
          {
            "id": "p48",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{Moles} = \\frac{\\text{Given Mass}}{\\text{Molar Mass}} = \\frac{24}{12} = 2 \\text{ moles}$$",
            "start": 2174,
            "end": 2270
          },
          {
            "id": "p49",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**Step 2:** Find number of atoms",
            "start": 2272,
            "end": 2304
          },
          {
            "id": "p50",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$\\text{Number of atoms} = \\text{Moles} \\times 6.022 \\times 10^{23}$$",
            "start": 2305,
            "end": 2374
          },
          {
            "id": "p51",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "equation"
            ],
            "review_flags": [],
            "text": "$$= 2 \\times 6.022 \\times 10^{23} = 1.2044 \\times 10^{24} \\text{ atoms}$$",
            "start": 2375,
            "end": 2448
          },
          {
            "id": "p52",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 2450,
            "end": 2453
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The worked calculations for moles (24 / 12 = 2 mol) and number of atoms (2 * 6.022 x 10^23 = 1.2044 x 10^24 atoms) are entirely correct.",
