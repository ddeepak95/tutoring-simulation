      {
        "id": "u1",
        "kind": "ANALOGY",
        "label": "The dozen analogy for the mole",
        "attributes": {},
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Uses the familiar everyday counting word 'dozen' to explain that a mole is simply a word representing a specific count.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p7",
              "quote": "* If I say \"a dozen eggs,\" you know that means **12** eggs."
