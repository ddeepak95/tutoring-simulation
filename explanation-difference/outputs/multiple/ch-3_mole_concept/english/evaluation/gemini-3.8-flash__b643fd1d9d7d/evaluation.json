        "passages": [
          {
            "id": "p28",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Step 4: The Magic of the Periodic Table (Molar Mass)",
            "start": 1699,
            "end": 1755
          },
          {
            "id": "p29",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Here is where the magic happens. Grab a Periodic Table and look at **Carbon (C)**. ",
            "start": 1757,
            "end": 1840
          },
          {
            "id": "p30",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "You will see its atomic mass is roughly **12.01**.",
            "start": 1841,
            "end": 1891
          },
          {
            "id": "p31",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "* One single atom of carbon weighs 12.01 *atomic mass units* (amu) — an impossibly tiny amount.",
            "start": 1893,
            "end": 1988
          },
          {
            "id": "p32",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "* But if you gather **1 MOLE** ($6.022 \\times 10^{23}$ atoms) of Carbon, it will weigh exactly **12.01 GRAMS**!",
            "start": 1989,
            "end": 2100
          },
          {
            "id": "p33",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Scientists chose the number $6.022 \\times 10^{23}$ on purpose so that the numbers on the periodic table match real-world grams.",
            "start": 2102,
            "end": 2229
          },
          {
            "id": "p34",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "This weight is called the **Molar Mass** (the mass of one mole of a substance), and its unit is **grams per mole (g/mol)**.",
            "start": 2231,
            "end": 2354
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly explains the correspondence between atomic mass units and grams per mole for one mole of an element.",
