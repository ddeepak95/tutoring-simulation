            ],
            "review_flags": [],
            "text": "### Step 3: Why Do We Need Such a Huge Number?",
            "start": 1311,
            "end": 1357
          },
          {
            "id": "p24",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine you are in a lab, and your experiment requires you to react Hydrogen with Oxygen. ",
            "start": 1359,
            "end": 1449
          },
          {
            "id": "p25",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "You cannot pick up individual atoms with tweezers—they are too small to see, let alone hold! You have to use a scale to weigh them in **grams**. ",
            "start": 1451,
            "end": 1596
          },
          {
            "id": "p26",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**The mole is the bridge between the microscopic world of atoms and the real world of grams.**",
            "start": 1598,
            "end": 1692
          },
          {
            "id": "p27",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 1694,
            "end": 1697
          }
        ],
        "accuracy": {
          "verdict": "accurate",
