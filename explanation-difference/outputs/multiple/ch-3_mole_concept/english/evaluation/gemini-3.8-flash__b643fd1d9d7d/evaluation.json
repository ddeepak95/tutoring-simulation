        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Welcome to chemistry! Don’t worry if the **mole concept** sounds intimidating—almost every chemistry student struggles with it at first. ",
            "start": 0,
            "end": 137
          },
          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "As your teacher, I’m going to let you in on a secret: **A mole is just a counting word.** ",
            "start": 139,
            "end": 229
          },
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "social"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Let’s break it down step-by-step.",
            "start": 231,
            "end": 264
          },
          {
            "id": "p4",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 266,
            "end": 269
          },
          {
            "id": "p5",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### Step 1: The \"Dozen\" Analogy",
            "start": 271,
            "end": 302
          },
          {
            "id": "p6",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Think about the word **\"dozen.\"** ",
            "start": 304,
            "end": 338
          },
          {
            "id": "p7",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "* If I say \"a dozen eggs,\" you know that means **12** eggs.",
            "start": 339,
            "end": 398
          },
          {
            "id": "p8",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "* If I say \"a dozen donuts,\" that’s **12** donuts.",
            "start": 399,
            "end": 449
          },
          {
            "id": "p9",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "* If I say \"a dozen cars,\" that’s **12** cars.",
            "start": 450,
            "end": 496
          },
          {
            "id": "p10",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "The word \"dozen\" always means the number **12**, regardless of what you are counting.",
            "start": 498,
            "end": 583
          },
          {
            "id": "p11",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "In chemistry, **a \"mole\" (abbreviated as *mol*) is the exact same thing.** It’s just a word that represents a specific number. ",
            "start": 585,
            "end": 712
          },
          {
            "id": "p12",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "However, because atoms and molecules are insanely tiny, a chemist's \"dozen\" has to be insanely huge.",
            "start": 714,
            "end": 814
          },
          {
            "id": "p13",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "separator"
            ],
            "review_flags": [],
            "text": "---",
            "start": 816,
            "end": 819
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The analogy correctly relates the everyday grouping term 'dozen' to the chemical counting unit 'mole'.",
          "errors": []
        }
      },
