            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1. Pourquoi avons-nous besoin de la mole ?",
            "start": 196,
            "end": 242
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Les atomes et les molécules sont **extrêmement petits**. On ne peut pas les compter un par un comme des billes.  ",
            "start": 244,
            "end": 357
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Si on voulait faire des calculs avec des nombres aussi énormes, ce serait impraticable. Les chimistes ont donc inventé une **unité de comptage** adaptée : la **mole**.",
            "start": 530,
            "end": 697
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Correctly states that atoms are too tiny and numerous to count individually, necessitating an appropriate counting unit.",
          "errors": []
        }
      },
