              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "इस संख्या को **अवोगाद्रो संख्या** (Avogadro’s number) कहते हैं।  ",
            "start": 437,
            "end": 502
          },
          {
            "id": "p8",
