        ],
        "rationale": "Explains why Avogadro's number is enormous due to the sub-microscopic mass of atoms, and why chemists weigh samples instead of counting individual particles.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p12",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 2. Why This Huge Number?",
            "start": 790,
            "end": 818
          },
          {
            "id": "p13",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Because atoms are extremely small.  ",
            "start": 819,
            "end": 855
          },
          {
            "id": "p14",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 1 gram of hydrogen contains about 6 × 10²³ atoms.  ",
            "start": 856,
            "end": 909
          },
          {
            "id": "p15",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "If you tried to count them at the rate of 1 atom per second, it would take you about **19 million years** to finish counting one mole!",
            "start": 910,
            "end": 1044
          },
          {
            "id": "p16",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "So instead of counting particles, chemists **weigh** them. That’s the clever part of the mole concept.",
            "start": 1046,
            "end": 1148
          }
        ],
        "accuracy": {
          "verdict": "contains_error",
          "reason": "The calculation in passage p15 substantially underestimates the time required to count one mole at a rate of 1 atom per second.",
          "errors": [
            {
              "passage_ids": [
                "p15"
              ],
              "description": "Counting at a rate of 1 atom per second would take 6.022 × 10²³ seconds. Dividing by ~3.156 × 10⁷ seconds per year yields approximately 1.91 × 10¹⁶ years (about 19 quadrillion years), not 19 million years.",
              "correction": "Counting one mole of atoms at 1 atom per second would take approximately 1.9 × 10¹⁶ years (about 19 quadrillion years).",
              "severity": "minor"
            }
          ]
        }
      },
