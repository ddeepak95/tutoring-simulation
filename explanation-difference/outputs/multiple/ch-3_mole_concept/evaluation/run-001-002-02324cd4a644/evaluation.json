          ]
        },
        "passages": [
          {
            "id": "p1",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "**The Mole Concept – Explained Simply**",
            "start": 0,
            "end": 39
          },
          {
            "id": "p2",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Imagine you want to buy eggs. You don’t count them one by one; you ask for “one dozen.” One dozen always means **12 eggs**. Chemists face the same problem, but with atoms and molecules. Atoms are so tiny that you can’t count them directly. So scientists created a special “counting unit” called the **mole**.",
            "start": 41,
            "end": 349
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The analogy correctly relates counting objects by dozens to counting atoms and molecules using moles.",
          "errors": []
        }
      },
      {
