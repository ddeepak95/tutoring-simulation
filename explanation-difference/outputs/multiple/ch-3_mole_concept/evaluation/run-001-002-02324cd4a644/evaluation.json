        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p3",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### 1. What is a Mole?",
            "start": 351,
            "end": 373
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "A **mole** is just a number — a very large number.  ",
            "start": 374,
            "end": 426
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "equation",
              "prose"
            ],
            "review_flags": [],
            "text": "**1 mole = 6.022 × 10²³ particles**",
            "start": 427,
            "end": 462
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "This number is called **Avogadro’s number** (Nₐ).  ",
            "start": 464,
            "end": 515
          },
          {
            "id": "p7",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "So:",
            "start": 516,
            "end": 519
          },
          {
            "id": "p8",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 1 mole of carbon atoms = 6.022 × 10²³ carbon atoms",
            "start": 520,
            "end": 572
          },
          {
            "id": "p9",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 1 mole of water molecules = 6.022 × 10²³ water molecules",
            "start": 573,
            "end": 631
          },
          {
            "id": "p10",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- 1 mole of oxygen gas = 6.022 × 10²³ oxygen molecules",
            "start": 632,
            "end": 686
          },
          {
            "id": "p11",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "It’s like saying “one dozen = 12” but instead of 12, it’s 602,200,000,000,000,000,000,000 particles!",
            "start": 688,
            "end": 788
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition of the mole, the value of Avogadro's number, and the particle count representations are factually correct.",
          "errors": []
        }
