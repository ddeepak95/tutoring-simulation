        "id": "u1",
        "kind": "ANALOGY",
        "label": "Dozen-to-mole counting analogy",
        "attributes": {},
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Introduces the mole by drawing an analogy to buying eggs by the dozen to explain why chemists need a counting unit for microscopic particles.",
        "review_flags": [],
        "contextualization": {
          "value": "everyday",
          "evidence": [
            {
              "passage_id": "p2",
              "quote": "Imagine you want to buy eggs. You don’t count them one by one; you ask for “one dozen.” One dozen always means **12 eggs**."
