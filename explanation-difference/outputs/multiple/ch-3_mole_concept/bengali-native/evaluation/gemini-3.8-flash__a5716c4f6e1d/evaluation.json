            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "এই সংখ্যাটাকে বলা হয় **অ্যাভোগাড্রো সংখ্যা** (Avogadro's Number), সংক্ষেপে একে $N_A$ লেখা হয়। ",
            "start": 913,
            "end": 1009
