            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "ஒரே தனிமத்தின் அனைத்து ஐசோடோப்புகளிலும்:",
            "start": 574,
            "end": 614
          },
          {
            "id": "p11",
