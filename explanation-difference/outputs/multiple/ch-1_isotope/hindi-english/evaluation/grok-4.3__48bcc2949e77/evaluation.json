          {
            "id": "p3",
            "category": "ANALOGY",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "कल्पना करो कि एक तत्व के परमाणु एक परिवार के सदस्य हैं। परिवार के सभी सदस्यों में कुछ चीजें एक जैसी होती हैं और कुछ अलग। ठीक उसी तरह:",
            "start": 120,
            "end": 253
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "**समस्थानिक** एक ही तत्व के वे परमाणु होते हैं जिनमें **प्रोटॉन की संख्या समान** होती है, लेकिन **न्यूट्रॉन की संख्या भिन्न** होती है।",
            "start": 255,
            "end": 389
          },
