        ],
        "rationale": "States the fundamental definition of an isotope as atoms of the same element having identical proton numbers but differing neutron numbers.",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Un **isotope** est une version d’un élément chimique qui a le **même nombre de protons**, mais un **nombre différent de neutrons**.",
            "start": 410,
            "end": 541
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The definition is standard and factually correct.",
          "errors": []
        }
