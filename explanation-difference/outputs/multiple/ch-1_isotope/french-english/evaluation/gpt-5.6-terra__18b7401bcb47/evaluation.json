            ],
            "review_flags": [],
            "text": "Un **isotope** est une version différente d’un même élément chimique.",
            "start": 0,
            "end": 69
          },
          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Tous les atomes d’un même élément ont le même nombre de **protons** dans leur noyau. C’est ce nombre qui définit l’élément.",
            "start": 71,
            "end": 194
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "En revanche, les isotopes d’un même élément n’ont pas forcément le même nombre de **neutrons**.",
            "start": 196,
            "end": 291
          },
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Même nombre de protons → même élément chimique.",
            "start": 293,
            "end": 342
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Nombre de neutrons différent → isotope différent.",
            "start": 343,
            "end": 394
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Donc leur masse peut être différente.",
            "start": 395,
            "end": 434
          }
