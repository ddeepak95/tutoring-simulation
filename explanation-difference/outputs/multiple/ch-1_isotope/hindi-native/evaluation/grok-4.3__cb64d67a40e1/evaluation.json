      {
        "id": "u2",
        "kind": "CONCEPT",
        "label": "Definition and nuclear composition of isotopes",
        "attributes": {
          "depth": "explanation"
        },
        "subtopic_ids": [
          "s1"
        ],
        "rationale": "Explains that isotopes are atoms of the same element having the same number of protons (atomic number) but differing numbers of neutrons (mass number).",
        "review_flags": [],
        "contextualization": {
          "value": "none",
          "evidence": []
        },
        "passages": [
          {
            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "ठीक इसी तरह, **समस्थानिक** एक ही तत्व (Element) के परमाणु होते हैं, जिनमें:",
            "start": 345,
            "end": 420
          },
          {
            "id": "p5",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- **प्रोटॉन** की संख्या **समान** होती है (इसलिए वे एक ही तत्व कहलाते हैं)",
            "start": 421,
            "end": 494
          },
          {
            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- लेकिन **न्यूट्रॉन** की संख्या **अलग-अलग** होती है",
            "start": 495,
            "end": 546
          },
          {
            "id": "p7",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "इस वजह से उनका **द्रव्यमान** (मास) अलग-अलग होता है।",
            "start": 548,
            "end": 599
          },
          {
            "id": "p8",
            "category": "ORGANIZATION",
            "attributes": {
              "subtype": "structural"
            },
            "formats": [
              "heading"
            ],
            "review_flags": [],
            "text": "### सरल परिभाषा:",
            "start": 601,
            "end": 617
          },
          {
            "id": "p9",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> **समस्थानिक** वे परमाणु हैं जिनका **परमाणु क्रमांक (Atomic Number)** तो समान होता है, लेकिन **द्रव्यमान संख्या (Mass Number)** अलग-अलग होता है।",
            "start": 618,
            "end": 763
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "The scientific definitions of isotopes, atomic number, and mass number are accurate.",
