            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "> \"एक ही तत्व के ऐसे अलग-अलग रूप (परमाणु), जिनके पास **प्रोटॉन की संख्या (परमाणु क्रमांक) तो समान** होती है, लेकिन **न्यूट्रॉन की संख्या अलग** होने के कारण उनका **परमाणु भार (Mass Number) भिन्न** होता है, उन्हें **समस्थानिक (Isotopes)** कहते हैं।\"",
            "start": 915,
            "end": 1162
          }
        ],
        "accuracy": {
