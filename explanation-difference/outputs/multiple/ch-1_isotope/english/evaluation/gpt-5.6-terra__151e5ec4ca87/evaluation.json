            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- The number of **protons** decides which element it is.",
            "start": 123,
            "end": 179
          },
          {
            "id": "p3",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- The number of **neutrons** can change without changing the element.",
            "start": 180,
            "end": 249
          },
