            "id": "p4",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "list"
            ],
            "review_flags": [],
            "text": "- Therefore, isotopes of the same element have different **masses**.",
            "start": 250,
            "end": 318
          }
        ],
