            "text": "**Isotopes** are like different versions of the same element.",
            "start": 0,
            "end": 61
          },
          {
            "id": "p2",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Every atom has three main particles:",
            "start": 63,
            "end": 99
          },
