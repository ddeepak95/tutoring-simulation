            "id": "p6",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "An **isotope** is an atom that has the **same number of protons** (so it’s the same element) but a **different number of neutrons** (so it has a different mass).",
            "start": 318,
            "end": 479
          }
        ],
