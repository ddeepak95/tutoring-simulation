          {
            "id": "p36",
            "category": "CONCEPT",
            "attributes": {
              "depth": "explanation"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Presque oui. Comme les isotopes d’un élément ont le même nombre de protons, ils ont aussi généralement le même nombre d’électrons. Ils réagissent donc de façon très semblable chimiquement.",
            "start": 1296,
            "end": 1484
          },
          {
            "id": "p37",
            "category": "EXAMPLE",
            "attributes": {},
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "Par exemple, le carbone-12 et le carbone-14 peuvent tous deux former du dioxyde de carbone, \\(CO_2\\).",
            "start": 1486,
            "end": 1587
          },
          {
            "id": "p38",
            "category": "CONCEPT",
            "attributes": {
              "depth": "statement"
            },
            "formats": [
              "prose"
            ],
            "review_flags": [],
            "text": "En revanche, ils peuvent avoir des propriétés physiques légèrement différentes, notamment leur masse.",
            "start": 1589,
            "end": 1690
          }
        ],
        "accuracy": {
          "verdict": "accurate",
          "reason": "Chemical behavior is determined by the electronic structure (identical in neutral isotopes), while physical properties depend partly on mass, making the statements accurate.",
          "errors": []
        }
