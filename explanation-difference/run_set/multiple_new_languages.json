{
  "version": 2,
  "keywords_file": "../content/keywords.csv",
  "prompt_structures_file": "../content/prompt-structures.json",
  "defaults": {
    "topics": [
      "ch-1",
      "ch-2",
      "ch-3",
      "ch-4",
      "ch-5",
      "ch-6",
      "ch-7"
    ],
    "models": [
      "gpt-5.6-terra",
      "grok-4.3",
      "gemini-3.8-flash",
      "claude-sonnet-5",
      "llama-4-maverick"
    ]
  },
  "target_languages": [
    "hi",
    "bn",
    "ar",
    "fr"
  ],
  "conditions": [
    {
      "id": "native_prompt",
      "prompt_language": "$target",
      "response_language": "$target"
    },
    {
      "id": "english_prompt",
      "prompt_language": "en",
      "response_language": "$target"
    }
  ],
  "output_dir": "../outputs/multiple"
}
