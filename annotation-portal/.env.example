VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only account creation (Vercel function, local API, and provisioning CLI).
# Set in Vercel's environment settings as well. Never prefix this secret with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# For applying migrations through the Management API; keep local and server-only.
# SUPABASE_ACCESS_TOKEN=YOUR_PROJECT_SCOPED_PERSONAL_ACCESS_TOKEN
