VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Select cloud or local. Restart dev server / rebuild after changing.
SUPABASE_TARGET=cloud
# Named profiles override the legacy VITE_* settings above.
# SUPABASE_CLOUD_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_CLOUD_PUBLISHABLE_KEY=YOUR_CLOUD_PUBLISHABLE_KEY
# SUPABASE_CLOUD_SERVICE_ROLE_KEY=YOUR_CLOUD_SERVICE_ROLE_KEY
# Direct or session-pooler PostgreSQL URL from the dashboard Connect dialog.
# URL-encode special characters in the password. Required for syncing TO cloud.
# Cloud -> local can instead export read-only using SUPABASE_ACCESS_TOKEN.
# SUPABASE_CLOUD_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=verify-full
# npm run supabase:start populates these in ignored .env.local automatically.
# SUPABASE_LOCAL_URL=http://127.0.0.1:55321
# SUPABASE_LOCAL_PUBLISHABLE_KEY=LOCAL_ANON_KEY
# SUPABASE_LOCAL_SERVICE_ROLE_KEY=LOCAL_SERVICE_ROLE_KEY
# SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Server-only account creation (Vercel function, local API, and provisioning CLI).
# Set in Vercel's environment settings as well. Never prefix this secret with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# For applying migrations through the Management API; keep local and server-only.
# SUPABASE_ACCESS_TOKEN=YOUR_PROJECT_SCOPED_PERSONAL_ACCESS_TOKEN
# Server-only instructional highlight generation. Local CLI also reads ../.env.
# Set in Vercel only if using generation from the portal; never prefix with VITE_.
# GEMINI_API_KEY=YOUR_GOOGLE_API_KEY
# GOOGLE_API_KEY is also accepted. Evaluator runs always use direct Google.
